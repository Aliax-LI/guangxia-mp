.editor-page {
  padding-top: 24rpx;
  padding-bottom: 220rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 影像工作室画布 */
.studio-canvas {
  position: relative;
  background: #111111;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.canvas-image {
  width: 100%;
  display: block;
}

.canvas-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 8rpx var(--brand-neon, #d4f826);
}

/* 提示词卡片 */
.prompt-card {
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.head-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.head-tip {
  font-size: 22rpx;
  color: #8e8e93;
}

.editor-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #111111;
  background: #f4f4f7;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.textarea-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.counter {
  font-size: 22rpx;
  color: #aeafb8;
}

/* 底部操作条 */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #eeeeef;
  z-index: 100;
  box-sizing: border-box;
}

.gen-btn {
  width: 100%;
}
