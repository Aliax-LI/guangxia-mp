/* 登录 / 注册：一盏安全灯下的空白相纸。
   结构只有三段：品牌 → 表单 → 底部说明；中间一整块相纸，不切卡片。 */

.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: calc(40rpx + env(safe-area-inset-top)) var(--gutter)
    calc(40rpx + env(safe-area-inset-bottom));
  background: transparent;
  overflow: hidden;
}

/* 安全灯：顶部一盏可过曝的琥珀光，只用一层，不做球体 */
.login-glow {
  position: absolute;
  top: -420rpx;
  left: 50%;
  width: 900rpx;
  height: 900rpx;
  margin-left: -450rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201, 118, 27, 0.1) 0%,
    rgba(201, 118, 27, 0.03) 42%,
    rgba(201, 118, 27, 0) 70%
  );
  pointer-events: none;
}

.login-center-wrap {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 40rpx;
}

/* ── 品牌 ─────────────────────────────────────────────── */

.brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: var(--s6);
}

.brand-title {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -3rpx;
  color: var(--text-hi, #1c1815);
}

.brand-caption {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: var(--text-soft, #6f6355);
}

/* ── 表单 ─────────────────────────────────────────────── */

.form-section {
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 字段：不加框，一条相纸底线；聚焦时才让琥珀出现 */
.input-pill {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 108rpx;
  border-bottom: 1rpx solid var(--line);
  transition: border-color 0.18s ease;
}

.input-pill:focus-within {
  border-bottom-color: var(--brand-neon, #c9761b);
}

.input-icon {
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 30rpx;
  color: var(--text-hi, #1c1815);
  caret-color: var(--brand-neon, #c9761b);
}

.field-placeholder {
  color: var(--text-low, #8b7f70);
  font-size: 28rpx;
}

/* 验证码行 */
.verify-pill-wrap {
  display: flex;
  align-items: center;
  gap: var(--s3);
}

.verify-input-pill {
  flex: 1;
  min-width: 0;
}

.send-code-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line-strong);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-hi, #1c1815);
  background: transparent;
}

.send-code-btn:active {
  background: var(--fill-hover);
}

.send-code-btn.disabled {
  border-color: var(--line-weak);
  color: var(--text-low, #8b7f70);
  pointer-events: none;
}

/* 主按钮：唯一的填充块 */
.submit {
  width: 100%;
  margin-top: var(--s6);
  height: 100rpx;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  letter-spacing: 1rpx;
}

.btn.btn--primary.submit::after {
  display: none;
}

/* 次操作：文字链 */
.switch-mode {
  margin-top: var(--s4);
  text-align: center;
  font-size: 26rpx;
  color: var(--text-soft, #6f6355);
}

.switch-link {
  margin-left: 8rpx;
  font-weight: 700;
  color: var(--brand-neon, #c9761b);
}

/* ── 协议 ─────────────────────────────────────────────── */

.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: var(--s5);
  padding: 8rpx 0;
}

.custom-checkbox {
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

.custom-checkbox.checked {
  background: var(--brand-neon, #c9761b);
  border-color: var(--brand-neon, #c9761b);
}

.agreement-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-soft, #6f6355);
}

.link {
  color: var(--text-hi, #1c1815);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

/* ── 底部说明 ─────────────────────────────────────────── */

.footer-hint {
  position: relative;
  flex-shrink: 0;
  text-align: center;
}

.hint-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-low, #8b7f70);
}
