<view class="tpl-page">
  <!-- 吸顶头部：搜索承接标题的位置，标题交给原生导航栏，不再重复报一次页面名 -->
  <view class="sticky-header">
    <view class="search-bar">
      <t-icon name="search" size="32rpx" color="#6f6355" class="search-icon" />
      <input
        class="search-input"
        placeholder="{{searchPlaceholder}}"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onKeywordChange"
        bindconfirm="onSearch"
      />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearSearch" aria-role="button" aria-label="清空搜索">
        <t-icon name="close-circle-filled" size="30rpx" color="#8b7f70" />
      </view>
    </view>

    <!-- 一级分类：加载中先给 5 个文字宽度的骨架位，避免头部全空、内容区独灰 -->
    <scroll-view scroll-x class="primary-scroll" enhanced show-scrollbar="{{false}}">
      <view class="primary-track">
        <block wx:if="{{loading}}">
          <view class="sk-line primary-sk" wx:for="{{[0,1,2,3,4]}}" wx:key="*this" style="width: {{112 + (index % 3) * 40}}rpx;"></view>
        </block>
        <block wx:else>
          <view
            wx:for="{{primaryCategories}}"
            wx:key="id"
            class="primary-item {{activePrimary === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectPrimary"
          >
            <text class="primary-text">{{item.name}}</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- 二级标签 -->
    <scroll-view scroll-x class="sub-scroll" enhanced show-scrollbar="{{false}}">
      <view class="sub-track">
        <block wx:if="{{loading}}">
          <view class="sk-pill sub-sk" wx:for="{{[0,1,2,3]}}" wx:key="*this" style="width: {{108 + (index % 2) * 32}}rpx;"></view>
        </block>
        <block wx:else>
          <view
            wx:for="{{subTags}}"
            wx:key="id"
            class="sub-pill {{activeSubTag === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectSubTag"
          >
            <text class="sub-text">{{item.name}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 加载态：按真实瀑布流比例铺骨架，首屏结构先到位，图到了再替换 -->
  <view wx:if="{{loading}}" class="wf-skeleton">
    <view class="wf-skeleton-col">
      <view class="sk-card" style="height: 620rpx;"></view>
      <view class="sk-card" style="height: 520rpx;"></view>
      <view class="sk-card" style="height: 700rpx;"></view>
    </view>
    <view class="wf-skeleton-col">
      <view class="sk-card" style="height: 480rpx;"></view>
      <view class="sk-card" style="height: 660rpx;"></view>
      <view class="sk-card" style="height: 560rpx;"></view>
    </view>
  </view>

  <view wx:elif="{{!leftColumn.length && !rightColumn.length}}" class="empty">
    <view class="empty-mark">
      <t-icon name="search" size="52rpx" color="#6f6355" />
    </view>
    <text class="empty-title">{{keyword ? '没有找到「' + keyword + '」' : '这个分类还没有模板'}}</text>
    <text class="empty-sub">{{keyword ? '换个词试试，或者回到精选看看大家都在用什么' : '换一个分类试试'}}</text>
    <view class="empty-actions">
      <view wx:if="{{keyword}}" class="btn btn--ghost btn--sm" bindtap="onClearSearch">清空搜索</view>
      <view class="btn btn--primary btn--sm" bindtap="onSelectPrimary" data-id="ai">看精选</view>
    </view>
  </view>

  <!-- 真正的错落双列瀑布流 -->
  <view wx:else class="waterfall-container">
    <!-- 左列 -->
    <view class="waterfall-col">
      <view
        wx:for="{{leftColumn}}"
        wx:key="id"
        class="wf-card"
        data-id="{{item.id}}"
        bindtap="onOpenTemplate"
      >
        <view class="wf-cover-box">
          <image
            class="wf-cover-img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            style="height: {{700 / (item.aspectRatio || 1.3)}}rpx;"
            lazy-load
            data-id="{{item.id}}"
            data-column="left"
            binderror="onCoverError"
          />
        </view>
        <view class="wf-body">
          <text class="wf-title">{{item.title}}</text>
          <view class="wf-meta-row">
            <text class="author-name">{{item.author.name || '光匣创作者'}}</text>
            <view class="wf-like" data-id="{{item.id}}" catchtap="onToggleLike">
              <t-icon
                name="{{item.liked ? 'heart-filled' : 'heart'}}"
                size="26rpx"
                color="{{item.liked ? '#c9761b' : '#6f6355'}}"
              />
              <text wx:if="{{item.liked}}" class="like-num liked">{{item.likes}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 右列 -->
    <view class="waterfall-col">
      <view
        wx:for="{{rightColumn}}"
        wx:key="id"
        class="wf-card"
        data-id="{{item.id}}"
        bindtap="onOpenTemplate"
      >
        <view class="wf-cover-box">
          <image
            class="wf-cover-img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            style="height: {{700 / (item.aspectRatio || 1.3)}}rpx;"
            lazy-load
            data-id="{{item.id}}"
            data-column="right"
            binderror="onCoverError"
          />
        </view>
        <view class="wf-body">
          <text class="wf-title">{{item.title}}</text>
          <view class="wf-meta-row">
            <text class="author-name">{{item.author.name || '光匣创作者'}}</text>
            <view class="wf-like" data-id="{{item.id}}" catchtap="onToggleLike">
              <t-icon
                name="{{item.liked ? 'heart-filled' : 'heart'}}"
                size="26rpx"
                color="{{item.liked ? '#c9761b' : '#6f6355'}}"
              />
              <text wx:if="{{item.liked}}" class="like-num liked">{{item.likes}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部触底状态 -->
  <view class="footer-state">
    <t-loading wx:if="{{loadingMore}}" theme="dots" size="36rpx" text="加载更多灵感" />
    <text wx:elif="{{!hasMore && (leftColumn.length || rightColumn.length)}}" class="foot-tip">到底了 · 新模板每天更新</text>
  </view>

  <!-- 悬浮主操作 -->
  <view class="fab" catchtap="onFabClick" aria-role="button" aria-label="AI 创作">
    <t-icon name="add" size="48rpx" color="#fffdf9" />
  </view>

  <!-- 豆包式 AI 创作悬浮卡片 -->
  <view wx:if="{{composerOpen}}" class="cc-mask" catchtap="closeComposer" catchtouchmove="noop">
    <view
      class="cc-sheet"
      style="{{keyboard ? 'bottom:' + keyboard + 'px;padding-bottom:20rpx;' : ''}}"
      catchtap="noop"
      aria-role="dialog"
      aria-label="图片创作"
    >
      <view class="cc-head">
        <view class="cc-mode-group">
          <view class="cc-mode-pill on">图片创作</view>
        </view>
        <view class="cc-close" catchtap="closeComposer" aria-role="button" aria-label="关闭">
          <t-icon name="close" size="30rpx" color="#6f6355" />
        </view>
      </view>

      <!-- 参考图槽位 -->
      <view class="cc-ref-row">
        <view wx:if="{{refImages.length}}" class="cc-ref-preview">
          <image class="cc-ref-img" src="{{refImages[0]}}" mode="aspectFill" catchtap="onPickRefImage" />
          <view class="cc-ref-del" catchtap="onRemoveRefImage" aria-role="button" aria-label="移除参考图">
            <t-icon name="close" size="20rpx" color="#fffdf9" />
          </view>
        </view>
        <view wx:else class="cc-ref-add" catchtap="onPickRefImage" aria-role="button" aria-label="添加参考图">
          <t-icon name="add" size="36rpx" color="#c9761b" />
          <text class="cc-ref-txt">参考图</text>
        </view>
      </view>

      <!-- 点击参数胶囊时原地展开的一行选项条 -->
      <scroll-view wx:if="{{activeParam}}" class="cc-sub-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="cc-sub-track">
          <block wx:if="{{activeParam === 'ratio'}}">
            <view
              wx:for="{{ratios}}"
              wx:key="id"
              class="cc-sub-pill {{ratioId === item.id ? 'on' : ''}}"
              data-group="ratio"
              data-id="{{item.id}}"
              catchtap="onPickComposerOpt"
            >{{item.label}}</view>
          </block>
          <block wx:elif="{{activeParam === 'count'}}">
            <view
              wx:for="{{counts}}"
              wx:key="*this"
              class="cc-sub-pill {{count === item ? 'on' : ''}}"
              data-group="count"
              data-id="{{item}}"
              catchtap="onPickComposerOpt"
            >{{item}} 张</view>
          </block>
          <block wx:elif="{{activeParam === 'quality'}}">
            <view
              wx:for="{{qualities}}"
              wx:key="id"
              class="cc-sub-pill {{quality === item.id ? 'on' : ''}}"
              data-group="quality"
              data-id="{{item.id}}"
              catchtap="onPickComposerOpt"
            >{{item.shortLabel || item.label}}</view>
          </block>
          <block wx:elif="{{activeParam === 'model'}}">
            <view
              wx:for="{{imageModelLabels}}"
              wx:key="*this"
              class="cc-sub-pill {{imageModelIndex === index ? 'on' : ''}}"
              data-group="model"
              data-id="{{index}}"
              catchtap="onPickComposerOpt"
            >{{item}}</view>
          </block>
        </view>
      </scroll-view>

      <!-- 一行式紧凑参数胶囊 -->
      <scroll-view class="cc-params-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="cc-params-track">
          <view class="cc-param {{activeParam === 'model' ? 'open' : ''}}" data-param="model" catchtap="onToggleParam">
            <text class="cc-param-k">模型</text>
            <text class="cc-param-v">{{imageModelShort}}</text>
            <t-icon name="{{activeParam === 'model' ? 'chevron-up' : 'chevron-down'}}" size="22rpx" color="#6f6355" />
          </view>
          <view class="cc-param {{activeParam === 'ratio' ? 'open' : ''}} {{ratioId !== 'auto' ? 'active' : ''}}" data-param="ratio" catchtap="onToggleParam">
            <text class="cc-param-k">比例</text>
            <text class="cc-param-v">{{ratioShort}}</text>
            <t-icon name="{{activeParam === 'ratio' ? 'chevron-up' : 'chevron-down'}}" size="22rpx" color="#6f6355" />
          </view>
          <view class="cc-param {{activeParam === 'count' ? 'open' : ''}} {{count > 1 ? 'active' : ''}}" data-param="count" catchtap="onToggleParam">
            <text class="cc-param-v">{{count}} 张</text>
            <t-icon name="{{activeParam === 'count' ? 'chevron-up' : 'chevron-down'}}" size="22rpx" color="#6f6355" />
          </view>
          <view class="cc-param {{activeParam === 'quality' ? 'open' : ''}} {{quality !== 'auto' ? 'active' : ''}}" data-param="quality" catchtap="onToggleParam">
            <text class="cc-param-k">画质</text>
            <text class="cc-param-v">{{qualityShort}}</text>
            <t-icon name="{{activeParam === 'quality' ? 'chevron-up' : 'chevron-down'}}" size="22rpx" color="#6f6355" />
          </view>
        </view>
      </scroll-view>

      <!-- 输入框与发送按钮 -->
      <view class="cc-input-row">
        <textarea
          class="cc-textarea"
          value="{{draft}}"
          placeholder="描述你想要创作的内容…"
          placeholder-class="cc-placeholder"
          auto-height
          maxlength="4000"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          confirm-type="send"
          bindinput="onComposerDraft"
          bindconfirm="onSubmitComposer"
          bindkeyboardheightchange="onComposerKeyboard"
        />
        <view
          class="cc-send {{canSend ? 'on' : ''}}"
          catchtap="onSubmitComposer"
          aria-role="button"
          aria-label="开始生成"
        >
          <view class="cc-send-arrow" aria-hidden="true"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showPrivacyPanel}}" class="privacy-mask" catchtouchmove="true">
    <view class="privacy-card">
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-desc">{{privacyDesc}}</text>
      <text class="privacy-link" bindtap="onOpenPrivacyContract">查看隐私保护指引</text>
      <view class="privacy-actions">
        <button
          id="tpl-agree-btn"
          class="privacy-agree-btn"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onPrivacyAgree"
        >
          同意并继续
        </button>
      </view>
    </view>
  </view>
</view>
