.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(60, 45, 25, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.privacy-card {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 36rpx 34rpx;
  border-radius: 28rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(28, 24, 21, 0.1);
  box-shadow: 0 32rpx 80rpx rgba(60, 45, 25, 0.6);
  box-sizing: border-box;
}

.privacy-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1815;
  text-align: center;
}

.privacy-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5c5145;
  line-height: 1.6;
}

.privacy-link {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #c9761b;
  text-align: center;
}

.privacy-actions {
  margin-top: 32rpx;
}

.privacy-agree-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 9999rpx;
  background: #c9761b;
  color: #fffdf9;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0;
}

.privacy-agree-btn::after {
  display: none;
}
