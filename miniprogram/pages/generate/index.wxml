<view class="generate-page">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="onClose">
        <t-icon name="close" size="48rpx" color="#FFFFFF" />
      </view>
      <text class="navbar-title">光匣</text>
      <view class="navbar-right">
        <text class="navbar-action" wx:if="{{!generating && !editingPrompt}}" bindtap="onShowMore">编辑更多</text>
      </view>
    </view>
  </view>

  <!-- 提示词编辑界面 -->
  <view wx:if="{{editingPrompt && !generating}}" class="prompt-editor">
    <view class="editor-container">
      <!-- 预览图 -->
      <view class="editor-preview" wx:if="{{previewImage}}">
        <image class="preview-thumb" src="{{previewImage}}" mode="aspectFill" />
        <view class="preview-mask">
          <text class="preview-label">原图预览</text>
        </view>
      </view>

      <!-- API 选择 -->
      <view class="api-selector">
        <view class="section-title">生成方式</view>
        <view class="api-options">
          <view 
            class="api-option {{apiType === 'generate' ? 'active' : ''}}"
            bindtap="onSelectApi"
            data-type="generate"
          >
            <view class="option-header">
              <t-icon name="sparkles" size="40rpx" color="{{apiType === 'generate' ? '#D4F826' : '#666'}}" />
              <text class="option-title">文生图</text>
            </view>
            <text class="option-desc">纯提示词生成，适合创意内容</text>
          </view>
          <view 
            class="api-option {{apiType === 'edit' ? 'active' : ''}}"
            bindtap="onSelectApi"
            data-type="edit"
          >
            <view class="option-header">
              <t-icon name="image-edit" size="40rpx" color="{{apiType === 'edit' ? '#D4F826' : '#666'}}" />
              <text class="option-title">图生图</text>
            </view>
            <text class="option-desc">基于原图编辑，适合图片优化</text>
            <text class="option-tip" wx:if="{{!previewImage}}">需要上传图片</text>
          </view>
        </view>
      </view>

      <!-- 提示词输入 -->
      <view class="prompt-input-section">
        <view class="section-title">提示词</view>
        <textarea
          class="prompt-textarea"
          value="{{promptInput}}"
          placeholder="描述你想要的效果，例如：柔光人像、电影质感、复古滤镜..."
          maxlength="500"
          bindinput="onPromptInput"
          auto-height
        />
        <view class="char-count">{{promptInput.length}}/500</view>
      </view>

      <!-- 底部按钮 -->
      <view class="editor-footer">
        <button class="btn-cancel" bindtap="onCancelEdit">取消</button>
        <button class="btn-generate" bindtap="onConfirmGenerate">
          <t-icon name="check" size="32rpx" color="#111111" />
          <text>开始生成</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 预览区域 -->
  <view class="preview-area" wx:if="{{!editingPrompt}}">
    <!-- 背景模糊图 -->
    <image wx:if="{{previewImage}}" class="bg-blur" src="{{previewImage}}" mode="aspectFill" />
    
    <!-- 主预览图 -->
    <view class="main-preview">
      <image 
        wx:if="{{resultImage}}" 
        class="preview-image" 
        src="{{resultImage}}" 
        mode="aspectFit"
        bindload="onImageLoad"
      />
      <image 
        wx:elif="{{previewImage}}" 
        class="preview-image placeholder" 
        src="{{previewImage}}" 
        mode="aspectFit"
      />
    </view>

    <!-- 生成进度 -->
    <view wx:if="{{generating}}" class="progress-overlay">
      <view class="progress-content">
        <!-- 醒图风格的圆形进度 -->
        <view class="progress-ring">
          <view class="ring-track"></view>
          <view 
            class="ring-fill" 
            style="stroke-dashoffset: {{283 - (283 * progress / 100)}}"
          ></view>
          <svg class="ring-svg" viewBox="0 0 100 100">
            <circle class="ring-bg" cx="50" cy="50" r="45" />
            <circle 
              class="ring-progress" 
              cx="50" cy="50" r="45"
              style="stroke-dasharray: 283; stroke-dashoffset: {{283 - (283 * progress / 100)}}"
            />
          </svg>
          <text class="progress-text">{{progress}}%</text>
        </view>
        
        <text class="progress-label">{{statusText}}</text>
        <text class="progress-hint">预计剩余 {{remainingTime}} 秒，请耐心等待</text>
        
        <!-- 取消按钮 -->
        <view class="cancel-btn" bindtap="onCancel">
          <text>取消</text>
        </view>
      </view>
    </view>

    <!-- 完成状态 -->
    <view wx:if="{{completed && !generating}}" class="complete-overlay">
      <view class="complete-badge">
        <t-icon name="check-circle" size="64rpx" color="#D4F826" />
        <text class="complete-text">生成完成</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-toolbar" wx:if="{{!generating}}">
    <view class="tool-left">
      <view class="tool-btn" bindtap="onSaveToAlbum">
        <t-icon name="download" size="44rpx" color="#FFFFFF" />
        <text>导出</text>
      </view>
    </view>
    
    <view class="tool-center">
      <view class="primary-btn" bindtap="onOneKeyExport">
        <t-icon name="check" size="40rpx" color="#111111" />
        <text>一键出片</text>
      </view>
    </view>

    <view class="tool-right">
      <view class="tool-btn" bindtap="onShare">
        <t-icon name="share" size="44rpx" color="#FFFFFF" />
        <text>分享</text>
      </view>
    </view>
  </view>

  <!-- 滑动调节色彩强度（仅在完成后显示） -->
  <view class="color-adjuster" wx:if="{{completed && !generating}}">
    <view class="adjuster-header">
      <text class="adjuster-title">色彩强度</text>
      <text class="adjuster-value">{{colorIntensity}}</text>
    </view>
    <slider 
      class="adjuster-slider"
      min="0"
      max="100"
      value="{{colorIntensity}}"
      activeColor="#D4F826"
      backgroundColor="#3A3A3C"
      block-size="24"
      bindchange="onColorIntensityChange"
    />
  </view>
</view>
