<view class="home" style="{{keyboard ? 'padding-bottom:' + keyboard + 'px' : ''}}">
  <view wx:if="{{!turns.length}}" class="stage">
    <view class="hello-block">
      <text class="hello">有什么我能帮你的吗？</text>
      <view class="seg">
        <view class="seg-item {{tool === 'chat' ? 'on' : ''}}" data-tool="chat" bindtap="onPickTool">对话</view>
        <view class="seg-item {{tool === 'image' ? 'on' : ''}}" data-tool="image" bindtap="onPickTool">画图</view>
      </view>
    </view>
    <view wx:if="{{!keyboard}}" class="recs">
      <text class="recs-k">为你推荐</text>
      <view
        wx:for="{{tool === 'image' ? imageIdeas : chatIdeas}}"
        wx:key="*this"
        class="idea"
        data-text="{{item}}"
        bindtap="onIdea"
      >{{item}}</view>
    </view>
  </view>

  <scroll-view
    wx:else
    class="thread"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTick}}"
    scroll-with-animation
  >
    <conversation
      turns="{{turns}}"
      bind:create="onOpenImage"
      bind:retry="onRetry"
      bind:preview="onPreview"
      bind:save="onSave"
      bind:choose="onChoose"
    />
  </scroll-view>

  <view wx:if="{{menuOpen || panelOpen}}" class="shade" catchtap="onClosePop"></view>

  <view class="dock">
    <view class="above">
      <view class="tool">
        <view class="chip" catchtap="onToggleMenu">
          <text>{{tool === 'image' ? '画图' : '对话'}}</text>
          <t-icon name="{{menuOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="#111111" />
        </view>
        <view wx:if="{{menuOpen}}" class="menu" catchtap="noop">
          <view class="menu-item {{tool === 'chat' ? 'on' : ''}}" data-tool="chat" catchtap="onPickTool">对话</view>
          <view class="menu-item {{tool === 'image' ? 'on' : ''}}" data-tool="image" catchtap="onPickTool">画图</view>
        </view>
      </view>
      <view wx:if="{{tool === 'image'}}" class="chip" catchtap="onTogglePanel">
        <text>{{ratioLabel}}</text>
        <t-icon name="{{panelOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="#111111" />
      </view>
      <view wx:if="{{refImage}}" class="thumb">
        <image class="thumb-img" src="{{refImage}}" mode="aspectFit" />
        <view class="thumb-x" catchtap="onClearRef">
          <t-icon name="close" size="20rpx" color="#ffffff" />
        </view>
      </view>
    </view>

    <view wx:if="{{panelOpen}}" class="panel" catchtap="noop">
      <text class="k">模型</text>
      <view class="model">{{imageModel}}</view>

      <text class="k">质量</text>
      <view class="opts">
        <view
          wx:for="{{qualities}}"
          wx:key="id"
          class="opt {{quality === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-group="quality"
          catchtap="onPickOpt"
        >{{item.label}}</view>
      </view>

      <text class="k">数量</text>
      <view class="opts">
        <view
          wx:for="{{counts}}"
          wx:key="*this"
          class="opt {{count === item ? 'on' : ''}}"
          data-id="{{item}}"
          data-group="count"
          catchtap="onPickOpt"
        >{{item}}张</view>
      </view>

      <text class="k">比例</text>
      <view class="opts">
        <view
          wx:for="{{ratios}}"
          wx:key="id"
          class="opt {{ratioId === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-group="ratio"
          catchtap="onPickOpt"
        >{{item.label}}</view>
      </view>

      <text class="k">分辨率</text>
      <view class="opts">
        <view
          wx:for="{{resolutions}}"
          wx:key="id"
          class="opt {{resolution === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-group="resolution"
          catchtap="onPickOpt"
        >{{item.label}}</view>
      </view>
    </view>

      <t-chat-sender
        value="{{draft}}"
        placeholder="{{tool === 'image' ? '描述想生成的画面' : '发消息'}}"
        adjust-position="{{false}}"
        auto-rise-with-keyboard="{{false}}"
        render-presets="{{senderPresets}}"
        bind:change="onDraft"
        bind:send="onSend"
        bind:keyboardheightchange="onKeyboard"
      >
        <view slot="footer-prefix" class="bits">
          <view class="cam" catchtap="onCamera">
            <t-icon name="camera" size="40rpx" color="#111111" />
          </view>
          <view wx:if="{{canSend}}" class="side go" catchtap="onSendTap">
            <view class="go-icon">
              <t-icon name="send-filled" size="32rpx" color="#ffffff" />
            </view>
          </view>
          <view wx:else class="side plus" catchtap="onAlbum">
            <t-icon name="add" size="40rpx" color="#111111" />
          </view>
        </view>
      </t-chat-sender>
  </view>

  <view wx:if="{{showPrivacyPanel}}" class="privacy-mask" catchtouchmove="true">
    <view class="privacy-card">
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-desc">{{privacyDesc}}</text>
      <text class="privacy-link" bindtap="onOpenPrivacyContract">查看隐私保护指引</text>
      <view class="privacy-actions">
        <button
          id="edit-agree-btn"
          class="privacy-agree-btn"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onPrivacyAgree"
        >
          同意并继续
        </button>
      </view>
    </view>
  </view>
</view>
