page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background: #070709;
}

.tpl-page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding-bottom: 200rpx;
  min-height: 100vh;
  background: #070709;
  box-sizing: border-box;
}

/* 刊物式页头 */
.tpl-masthead {
  padding: 20rpx 24rpx 10rpx;
}

/* 顶部吸顶区域 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 60;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(7, 7, 9, 0.94);
  backdrop-filter: blur(24px);
  padding: calc(12rpx + env(safe-area-inset-top)) 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* 胶囊搜索条 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.search-left {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  background: #16171b;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.search-icon {
  margin-right: 14rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 26rpx;
  color: #f4f4f6;
  caret-color: var(--brand-neon, #d4f826);
}

.search-placeholder {
  color: #7a7a83;
  font-size: 26rpx;
}

.search-btn {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-neon, #d4f826);
  padding: 10rpx 8rpx;
  flex-shrink: 0;
}

/* 一级大分类横滑条 */
.primary-scroll {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.primary-track {
  display: inline-flex;
  gap: 36rpx;
  padding: 6rpx 4rpx 8rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex-shrink: 0;
  padding-bottom: 10rpx;
}

.primary-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #8a8a93;
  transition: all 0.15s ease;
}

.primary-item.active .primary-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.primary-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 32rpx;
  height: 6rpx;
  margin-left: -16rpx;
  border-radius: 9999rpx;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 12rpx rgba(212, 248, 38, 0.55);
}

/* 二级胶囊药丸标签条 */
.sub-scroll {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.sub-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 4rpx 6rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.sub-pill {
  padding: 12rpx 30rpx;
  border-radius: 9999rpx;
  background: #16171b;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.sub-pill:active {
  transform: scale(0.97);
}

.sub-pill.active {
  background: var(--brand-neon, #d4f826);
  border-color: var(--brand-neon, #d4f826);
  box-shadow: 0 6rpx 20rpx rgba(212, 248, 38, 0.18);
}

.sub-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #a2a2ab;
}

.sub-pill.active .sub-text {
  color: #0a0b05;
  font-weight: 700;
}

/* 加载与空状态 */
.center-loading,
.center-empty {
  padding: 220rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 双列错落瀑布流容器 */
.waterfall-container {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 20rpx 24rpx 40rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.waterfall-col {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

/* 模版卡片 */
.wf-card {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: #0e0f12;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.15s ease;
}

.wf-card:active {
  transform: scale(0.985);
}

.wf-cover-box {
  position: relative;
  width: 100%;
  background: #141519;
}

.wf-cover-img {
  width: 100%;
  display: block;
  background-color: #141519;
}

.wf-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: rgba(0, 0, 0, 0.62);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #f4f4f6;
  font-size: 18rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.wf-body {
  padding: 16rpx 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.wf-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #f4f4f6;
  line-height: 1.38;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wf-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 2rpx;
  width: 100%;
  box-sizing: border-box;
}

.wf-author {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.author-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #1d1e24;
  flex-shrink: 0;
}

.author-name {
  font-size: 22rpx;
  color: #8a8a93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.wf-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.like-num {
  font-size: 22rpx;
  color: #8a8a93;
  font-variant-numeric: tabular-nums;
}

.like-num.liked {
  color: var(--brand-neon, #d4f826);
  font-weight: 600;
}

/* 底部状态 */
.footer-state {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.foot-tip {
  font-size: 22rpx;
  color: #7a7a83;
}

/* 荧光绿悬浮加号 */
.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  border: 4rpx solid rgba(7, 7, 9, 0.9);
  box-shadow: 0 10rpx 32rpx rgba(212, 248, 38, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  transition: transform 0.15s ease;
}

.fab-btn:active {
  transform: scale(0.92);
}
