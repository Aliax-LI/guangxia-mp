.logs-page {
  padding-top: 4rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #070709;
}

.logs-masthead {
  padding-bottom: 32rpx;
}

.center-state {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-wrap {
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: #0e0f12;
  border: 1rpx solid rgba(212, 248, 38, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 32rpx rgba(212, 248, 38, 0.1);
}

.empty-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a93;
  text-align: center;
  line-height: 1.5;
}

.empty-btn {
  margin-top: 40rpx;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 9999rpx;
  background: var(--brand-neon, #d4f826);
  color: #0a0b05;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(212, 248, 38, 0.16);
}

.empty-btn:active {
  transform: scale(0.98);
}

.record-sheet {
  padding: 8rpx 0;
  background: #0e0f12;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
}

.record-row--line {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(212, 248, 38, 0.1);
  border: 1rpx solid rgba(212, 248, 38, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f4f4f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  font-size: 24rpx;
  color: #8a8a93;
}

.record-cost-col {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.record-cost {
  font-size: 30rpx;
  font-weight: 700;
  color: #f4f4f6;
  font-variant-numeric: tabular-nums;
}

.record-cost-label {
  font-size: 20rpx;
  color: #7a7a83;
}

.foot-loading {
  padding: 36rpx 0;
  display: flex;
  justify-content: center;
}
