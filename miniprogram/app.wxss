@import './styles/tdesign-theme.wxss';

page {
  background: var(--td-bg-color-page);
  color: var(--td-text-color-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

/* 页面通用内边距 */
.page-pad {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.section-gap {
  margin-top: 32rpx;
}

/* 光匣卡片容器 */
.xt-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  box-sizing: border-box;
}

/* 光匣胶囊按钮 */
.xt-pill-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 9999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.12);
}

.xt-pill-btn:active {
  transform: scale(0.985);
  background: #262626;
}

.xt-pill-btn.disabled {
  background: #e5e5ea;
  color: #aeafb8;
  box-shadow: none;
  pointer-events: none;
}

.xt-pill-btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  color: #111111;
  border: 2rpx solid #111111;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.xt-pill-btn-outline:active {
  background: #f5f5f7;
  transform: scale(0.985);
}

/* 标志性荧光光晕 */
.xt-glow-orb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #d4f826;
  box-shadow: 0 0 70rpx 20rpx rgba(212, 248, 38, 0.55);
}

/* 微信隐私指引弹层（须用原生 button + agreePrivacyAuthorization） */
.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.privacy-card {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.privacy-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
  text-align: center;
}

.privacy-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #3a3a3c;
  line-height: 1.5;
}

.privacy-link {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #7ab800;
  text-align: center;
}

.privacy-actions {
  margin-top: 32rpx;
}

.privacy-agree-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
}

.privacy-agree-btn::after {
  display: none;
}
