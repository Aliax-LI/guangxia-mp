:host {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-height: 0;
}

/* 对话流：用户靠右成组，助手左对齐无气泡，靠墨色块与留白区分 */
.thread-scroll {
  width: 100%;
  height: 100%;
}

.list {
  width: 100%;
  padding: var(--s2) var(--gutter) var(--s4);
}

.turn {
  display: flex;
  flex-direction: column;
  gap: var(--s2);
  margin-bottom: var(--s5);
}

/* ── 用户侧 ───────────────────────────────────────────── */

.turn-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  max-width: 100%;
}

.user-media {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  max-width: 560rpx;
}

.user-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--r-inset);
  background: var(--ink-2);
}

.user-media.many .user-img {
  width: 176rpx;
  height: 176rpx;
}

.user-bubble {
  max-width: 560rpx;
  padding: 18rpx var(--s3);
  border-radius: var(--r-card) var(--r-inset) var(--r-card) var(--r-card);
  background: var(--ink-3);
  border: 1rpx solid var(--line-weak);
}

.user-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-hi);
  word-break: break-word;
}

/* ── 错误 ─────────────────────────────────────────────── */

.turn-assist {
  display: block;
  width: 100%;
  max-width: 100%;
}

.turn-assist.err {
  align-self: flex-start;
  max-width: 560rpx;
  padding: 20rpx var(--s3) 16rpx;
  border-radius: var(--r-inset) var(--r-card) var(--r-card) var(--r-card);
  background: var(--ink-2);
  border: 1rpx solid rgba(224, 90, 74, 0.3);
}

.err-mark {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.err-msg {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.55;
  color: var(--text-hi);
}

.err-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  height: 64rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-pill);
  background: transparent;
  border: 1rpx solid var(--line-strong);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-hi);
}

.err-retry:active {
  background: var(--fill-hover);
}

/* ── 生成中 / 成片 ────────────────────────────────────── */

.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shot {
  width: 440rpx;
  max-width: 100%;
  height: 540rpx;
  border-radius: var(--r-card);
  background: var(--ink-2);
}

.shots.many .shot {
  width: 292rpx;
  height: 376rpx;
}

/* 显影格：暖白相纸底，不用深色块——白底页面里挖一个黑洞是最刺眼的 */
.shot.wait {
  position: relative;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  /* 白底页面上必须一眼可辨：比页面底明显暗一档的相纸 + 实线描边 */
  background: #f3ead9;
  border: 1rpx solid rgba(28, 24, 21, 0.16);
}

/* 光扫：一道斜向的琥珀色柔光从上往下掠过纸面 */
.dev-sweep {
  position: absolute;
  top: -60%;
  left: -30%;
  width: 160%;
  height: 220%;
  background: linear-gradient(
    115deg,
    rgba(201, 118, 27, 0) 0%,
    rgba(201, 118, 27, 0.1) 36%,
    rgba(224, 155, 60, 0.34) 50%,
    rgba(201, 118, 27, 0.1) 64%,
    rgba(201, 118, 27, 0) 100%
  );
}

.dev-sweep.on {
  animation: dev-pass 2.8s ease-in-out infinite;
}

/* 纸纹：极淡的网点，避免大片纯色显得廉价 */
.dev-grain {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(28, 24, 21, 0.05) 1rpx, transparent 1rpx);
  background-size: 12rpx 12rpx;
  pointer-events: none;
}

/* 文字区：底部对齐，给显影留出上方大块留白 */
.wait-copy {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 0 28rpx 28rpx;
}

.wait-stage {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--text-hi, #1c1815);
}

/* 进度：一条 4rpx 的纸面刻度，琥珀填充 */
.wait-track {
  position: relative;
  height: 4rpx;
  margin-top: 16rpx;
  border-radius: 9999rpx;
  background: rgba(28, 24, 21, 0.08);
  overflow: hidden;
}

.wait-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: #c9761b;
  transition: width 0.4s ease;
}

.wait-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.wait-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #c9761b;
}

.wait-model {
  font-size: 20rpx;
  color: var(--text-soft, #6f6355);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes dev-pass {
  0% {
    transform: translate3d(0, -40%, 0);
  }
  100% {
    transform: translate3d(0, 40%, 0);
  }
}

.shot.photo {
  animation: develop-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.shot.photo:active {
  opacity: 0.88;
}

@keyframes develop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ink {
  from { transform: scaleX(0.45); opacity: 0.45; }
  to { transform: scaleX(1); opacity: 1; }
}

@keyframes think-pulse {
  0%,
  100% {
    opacity: 0.22;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.15);
  }
}

.ink {
  display: flex;
  align-items: center;
  height: 20rpx;
}

.ink-bar {
  width: 40rpx;
  height: 6rpx;
  border-radius: var(--r-pill);
  background: var(--brand-neon);
  transform-origin: left center;
  transform: scaleX(0.45);
  opacity: 0.5;
}

.ink-bar.on {
  animation: ink 900ms cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
}

/* 成片后的动作条：轻量文字按钮，不与页面级主操作抢琥珀实心 */
.actions {
  display: flex;
  gap: var(--s3);
}

.chip-act {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 4rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-mid, #5c5145);
}

.chip-act:active {
  opacity: 0.6;
}

.chip-act.done {
  color: var(--text-low, #8b7f70);
  font-weight: 500;
}

.chip-act.done text {
  color: var(--text-low, #8b7f70);
}

/* ── 助手文本 ─────────────────────────────────────────── */

.rich {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
  padding: 18rpx var(--s3) 20rpx;
  border-radius: var(--r-inset) var(--r-card) var(--r-card) var(--r-card);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
  color: var(--text-hi);
}

/* 等待首 token：与助手气泡同形，弱层级 */
.think {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 560rpx;
  padding: 18rpx var(--s3);
  border-radius: var(--r-inset) var(--r-card) var(--r-card) var(--r-card);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
}

.think-label {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-mid);
}

.think-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.think-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-neon);
  opacity: 0.28;
}

.think-dot.on {
  animation: think-pulse 900ms ease-in-out infinite;
}

.think-dot.d1.on {
  animation-delay: 160ms;
}

.think-dot.d2.on {
  animation-delay: 320ms;
}

/* ── GenUI 选项卡 ─────────────────────────────────────── */

.card {
  margin-top: var(--s3);
  padding: var(--s3);
  border-radius: var(--r-inset);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
}

.hint {
  display: block;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-low);
}

.choice {
  margin-top: 12rpx;
  padding: 18rpx var(--s3);
  border-radius: var(--r-inset);
  border: 1rpx solid var(--line);
  font-size: 27rpx;
  line-height: 1.45;
  color: var(--text-hi);
}

.choice.on {
  background: var(--brand-neon);
  border-color: var(--brand-neon);
  color: var(--brand-neon-ink);
  font-weight: 700;
}

.extra {
  width: 100%;
  margin-top: var(--s2);
  min-height: 92rpx;
  padding: 16rpx var(--s2);
  border-radius: var(--r-inset);
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
  font-size: 27rpx;
  line-height: 1.45;
  color: var(--text-hi);
  caret-color: var(--brand-neon);
}

.extra-ph {
  color: var(--text-low);
}

.go {
  margin-top: var(--s2);
  height: 80rpx;
  border-radius: var(--r-pill);
  background: var(--brand-neon);
  color: var(--brand-neon-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
}

.go:active {
  background: var(--brand-neon-active);
}

.copy-act {
  display: inline-flex;
  align-items: center;
  margin-top: var(--s2);
  padding: 12rpx var(--s3);
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-hi);
}

.copy-act:active {
  background: var(--fill-hover);
}

/* ── 空态 ─────────────────────────────────────────────── */

.empty {
  padding: 14vh var(--gutter) var(--s5);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
}

.empty-title {
  margin-top: var(--s3);
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.3;
  color: var(--text-hi);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--text-soft);
}

.empty-act {
  margin-top: var(--s4);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-pill);
  background: var(--brand-neon);
  color: var(--brand-neon-ink);
  font-size: 27rpx;
  font-weight: 700;
}

/* ── 降级：系统要求减少动效 ───────────────────────────── */

@media (prefers-reduced-motion: reduce) {
  .dev-sweep.on,
  .ink-bar.on,
  .think-dot.on,
  .shot.photo {
    animation: none;
  }

  .think-dot {
    opacity: 0.5;
  }

  .ink-bar {
    transform: none;
    opacity: 1;
  }
}
