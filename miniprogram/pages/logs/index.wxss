.logs-page {
  padding-top: 4rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f1e7;
}

.logs-masthead {
  padding-bottom: 32rpx;
}

.center-state {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-wrap {
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(201, 118, 27, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 32rpx rgba(201, 118, 27, 0.1);
}

.empty-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1815;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6f6355;
  text-align: center;
  line-height: 1.5;
}

.empty-btn {
  margin-top: 40rpx;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 9999rpx;
  background: var(--brand-neon, #c9761b);
  color: #fffdf9;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(201, 118, 27, 0.16);
}

.empty-btn:active {
  transform: scale(0.98);
}

.record-sheet {
  padding: 8rpx 0;
  background: #fffdf9;
  border-radius: 28rpx;
  border: 1rpx solid rgba(28, 24, 21, 0.07);
  box-shadow: 0 20rpx 48rpx rgba(60, 45, 25, 0.35);
  overflow: hidden;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
}

.record-row--line {
  border-bottom: 1rpx solid rgba(28, 24, 21, 0.06);
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(201, 118, 27, 0.1);
  border: 1rpx solid rgba(201, 118, 27, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1815;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  font-size: 24rpx;
  color: #6f6355;
}

.record-cost-col {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.record-cost {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1815;
  font-variant-numeric: tabular-nums;
}

.record-cost-label {
  font-size: 20rpx;
  color: #8b7f70;
}

.foot-loading {
  padding: 36rpx 0;
  display: flex;
  justify-content: center;
}
