.home {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--ink-0, #070709);
  overflow-x: hidden;
  /* 自定义 tabBar 占位：胶囊栏 132rpx + 呼吸间距，safe 由 tabBar 自身处理 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.home::before {
  content: '';
  position: fixed;
  top: -220rpx;
  right: -180rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 248, 38, 0.1) 0%, rgba(212, 248, 38, 0) 68%);
  pointer-events: none;
  z-index: 0;
}

.topbar {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx 12rpx;
  box-sizing: border-box;
}

.topbar-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topbar-btn:active {
  background: rgba(255, 255, 255, 0.06);
}

.topbar-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.topbar-kind {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-low, #8a8a93);
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.topbar-title {
  max-width: 100%;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-hi, #f4f4f6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 24rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.hello-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.hello {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
  color: var(--text-hi, #f4f4f6);
  text-align: left;
}

.hello-sub {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.45;
  color: var(--text-low, #8a8a93);
  text-align: left;
}

.recs {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.recs-k {
  margin-bottom: 4rpx;
  font-size: 24rpx;
  color: var(--text-low, #8a8a93);
}

.idea {
  max-width: 100%;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: var(--ink-1, #0e0f12);
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--text-hi, #f4f4f6);
}

.idea:active {
  background: var(--ink-2, #16171b);
  border-color: var(--line-strong, rgba(255, 255, 255, 0.16));
}

.thread {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
}

conversation {
  display: block;
  width: 100%;
  max-width: 100%;
}

.shade {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 4;
  background: rgba(0, 0, 0, 0.6);
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 580rpx;
  max-width: 86vw;
  z-index: 6;
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: var(--ink-1, #0e0f12);
  border-right: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  box-shadow: 16rpx 0 64rpx rgba(0, 0, 0, 0.6);
  transform: translateX(-105%);
  transition: transform 0.28s ease;
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

.drawer.open {
  transform: translateX(0);
}

.drawer-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-hi, #f4f4f6);
}

.drawer-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.drawer-close:active {
  background: rgba(255, 255, 255, 0.06);
}

.drawer-clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 24rpx 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-hi, #f4f4f6);
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
}

.drawer-clear.disabled {
  opacity: 0.45;
}

.drawer-new {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 8rpx 28rpx 28rpx;
}

.new-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hi, #f4f4f6);
}

.new-btn:active {
  background: var(--ink-2, #16171b);
}

.drawer-list {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

.drawer-list-inner {
  padding: 0 16rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sess {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 8rpx;
  border-radius: 20rpx;
}

.sess.on {
  background: var(--ink-2, #16171b);
}

.sess-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sess-kind {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--text-low, #8a8a93);
}

.sess.on .sess-kind {
  color: var(--brand-neon, #d4f826);
}

.sess-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-hi, #f4f4f6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sess.on .sess-title {
  font-weight: 600;
}

.sess-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.sess-time {
  font-size: 24rpx;
  color: #7a7a83;
}

.sess-del {
  padding: 8rpx;
  margin: -8rpx;
  border-radius: 12rpx;
}

.sess-del:active {
  background: rgba(255, 255, 255, 0.08);
}

.drawer-empty {
  padding: 48rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-low, #8a8a93);
  line-height: 1.5;
}

.dock {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  padding-bottom: 4rpx;
}

.home .t-chat-sender {
  margin: 4rpx 24rpx 0 !important;
  padding: 6rpx 12rpx 6rpx 8rpx !important;
  border-radius: 999rpx;
  border-color: var(--line, rgba(255, 255, 255, 0.1)) !important;
  background: var(--ink-1, #0e0f12) !important;
  box-shadow: none;
}

.home .t-chat-sender__header {
  display: none !important;
  padding: 0 !important;
}

.home .t-chat-sender__actions {
  flex-direction: row !important;
  align-items: center;
  padding: 0 !important;
  gap: 8rpx;
}

.home .t-chat-sender__footer,
.home .t-chat-sender__mode,
.bits {
  display: contents !important;
}

.home .t-chat-sender__textarea {
  order: 1;
  flex: 1;
  min-width: 80rpx;
  min-height: 56rpx !important;
  padding-bottom: 0 !important;
  display: flex;
  align-items: center;
}

.home .t-chat-sender__textarea--control {
  min-height: 40rpx !important;
  padding: 8rpx 0 !important;
  font-size: 28rpx !important;
  line-height: 40rpx !important;
  letter-spacing: 0;
  color: var(--text-hi, #f4f4f6) !important;
  caret-color: var(--brand-neon, #d4f826);
}

.home .t-chat-sender__textarea--placeholder {
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  line-height: 40rpx;
  color: #7a7a83 !important;
}

.home .t-chat-sender__sendbtn {
  display: none !important;
}

.above {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 4rpx;
}

.cam {
  order: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.side {
  order: 2;
  position: static;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.plus {
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
}

.go {
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 6rpx 20rpx rgba(212, 248, 38, 0.3);
}

.go:active {
  background: var(--brand-neon-active, #b8dc17);
}

.go t-icon,
.go-icon {
  display: flex;
  transform: rotate(-90deg);
}

.t-chat-message {
  max-width: 100%;
  min-width: 0;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.home .t-chat-message .t-chat-message__content {
  min-width: 0 !important;
  max-width: 100%;
  overflow: hidden;
}

.home .t-chat-content,
.home .t-chat-markdown,
.home .t-chat-markdown-p,
.home .t-chat-markdown-h,
.home .t-chat-markdown-h1,
.home .t-chat-markdown-h2,
.home .t-chat-markdown-h3,
.home .t-chat-markdown-list,
.home .t-chat-markdown-list-item {
  max-width: 100% !important;
  box-sizing: border-box;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.home .t-chat-markdown-h1 {
  font-size: 40rpx;
}

.home .t-chat-markdown-h2 {
  font-size: 36rpx;
}

.home .t-chat-markdown-h3 {
  font-size: 32rpx;
}

.home .t-chat-markdown-code,
.home .t-chat-markdown-table {
  max-width: 100%;
  box-sizing: border-box;
}

.home .t-chat-markdown-code__content {
  width: 100% !important;
  max-width: 100%;
  white-space: normal !important;
}

.home .t-chat-markdown-code__text {
  display: block !important;
  white-space: pre-wrap !important;
  word-break: break-all !important;
  overflow-wrap: anywhere !important;
}

.home .t-chat-markdown-table__container {
  max-width: 100% !important;
  white-space: normal !important;
}

.t-chat-message .t-chat-message__content--base {
  padding-top: 0;
}

.t-chat-message.right .t-chat-content,
.t-chat-message.user .t-chat-content,
.t-chat-message--base.right .t-chat-content {
  background: var(--ink-3, #1d1e24);
  color: var(--text-hi, #f4f4f6);
}

.t-chat-message.right .t-chat-content__user,
.t-chat-message.user .t-chat-content__user,
.t-chat-message--base.right .t-chat-content__user {
  color: var(--text-hi, #f4f4f6);
}

.t-chat-message--base.assistant .t-chat-content,
.t-chat-message--base.left .t-chat-content {
  background: transparent;
  padding: 0;
  color: var(--text-hi, #f4f4f6);
  line-height: 1.55;
}

.t-chat-message--base.assistant .t-chat-content__assistant,
.t-chat-message--base.left .t-chat-content__assistant {
  color: var(--text-hi, #f4f4f6);
}

.t-chat-message.assistant .t-chat-loading {
  display: inline-flex;
  max-width: 560rpx;
  min-height: auto;
  padding: 18rpx 28rpx;
  background: var(--ink-2, #16171b);
  border-radius: 8rpx 28rpx 28rpx 28rpx;
}

.t-chat-loading__moving--left,
.t-chat-loading__moving--right,
.t-chat-loading__moving--top {
  background-color: var(--brand-neon, #d4f826);
}

.tool {
  position: relative;
}

.chip {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: var(--ink-1, #0e0f12);
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hi, #f4f4f6);
}

.chip:active {
  background: var(--ink-2, #16171b);
}

.ref-strip {
  flex: 1;
  min-width: 0;
  max-width: 420rpx;
}

.ref-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 8rpx;
}

.thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: var(--ink-2, #16171b);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 0 0 0 10rpx;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu {
  position: absolute;
  left: 0;
  bottom: 72rpx;
  min-width: 168rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
}

.menu-item {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-mid, #a2a2ab);
}

.menu-item.on {
  background: var(--ink-3, #1d1e24);
  color: var(--text-hi, #f4f4f6);
  font-weight: 600;
}

.panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(100% + 8rpx);
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.65);
}

.k {
  display: block;
  margin: 22rpx 0 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--text-low, #8a8a93);
}

.k:first-child {
  margin-top: 0;
}

.model {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--ink-3, #1d1e24);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-hi, #f4f4f6);
}

.opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: transparent;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-mid, #a2a2ab);
}

.opt.on {
  background: var(--brand-neon, #d4f826);
  border-color: var(--brand-neon, #d4f826);
  color: var(--brand-neon-ink, #0a0b05);
  font-weight: 700;
}
