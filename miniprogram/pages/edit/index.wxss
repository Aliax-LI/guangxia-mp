.edit-page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding: 12rpx 32rpx calc(300rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* 导入照片卡片 */
.hero-import {
  position: relative;
  background: linear-gradient(158deg, #15161a 0%, #0e0f12 62%);
  color: #f4f4f6;
  padding: 46rpx 36rpx 32rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.42);
  overflow: hidden;
  transition: transform 0.15s ease;
}

.hero-import:active {
  transform: scale(0.985);
}

.hero-glow {
  position: absolute;
  top: -140rpx;
  right: -110rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 248, 38, 0.22) 0%, rgba(212, 248, 38, 0.05) 46%, transparent 70%);
  pointer-events: none;
}

.hero-import-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.import-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: var(--brand-neon, #d4f826);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 32rpx rgba(212, 248, 38, 0.28);
  flex-shrink: 0;
}

.import-info {
  flex: 1;
  min-width: 0;
}

.import-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.import-desc {
  display: block;
  font-size: 24rpx;
  color: #8a8a93;
  margin-top: 10rpx;
  line-height: 1.45;
}

.import-actions {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.action-pill {
  flex: 1;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.15s ease;
}

.action-pill:active {
  background: rgba(255, 255, 255, 0.1);
}

.action-pill--accent {
  background: var(--brand-neon, #d4f826);
  border-color: var(--brand-neon, #d4f826);
  box-shadow: 0 8rpx 24rpx rgba(212, 248, 38, 0.16);
}

.action-pill--accent:active {
  background: var(--brand-neon-active, #b8dc17);
}

.pill-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #f4f4f6;
}

.pill-text--ink {
  color: #0a0b05;
}

/* 照片预览卡片 */
.preview-box {
  position: relative;
  height: 480rpx;
  border-radius: 32rpx;
  background: #000;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.45);
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
}

.preview-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(12px);
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  color: #f4f4f6;
  font-size: 22rpx;
  font-weight: 500;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 10rpx var(--brand-neon, #d4f826);
}

.preview-btn-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(12px);
  padding: 10rpx 24rpx;
  border-radius: 9999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

.preview-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通用分区 */
.section {
  margin-top: 44rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f4f4f6;
  letter-spacing: -0.3rpx;
}

.section-tip {
  font-size: 22rpx;
  color: #8a8a93;
}

.clear-link {
  font-size: 24rpx;
  color: #8a8a93;
  padding: 4rpx 12rpx;
}

/* 风格预设卡片 */
.presets-scroll {
  width: 100%;
  white-space: nowrap;
}

.presets-track {
  display: inline-flex;
  gap: 18rpx;
  padding: 4rpx 4rpx 12rpx;
}

.preset-card {
  width: 200rpx;
  padding: 28rpx 20rpx 26rpx;
  border-radius: 26rpx;
  background: #0e0f12;
  border: 2rpx solid rgba(255, 255, 255, 0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  position: relative;
  transition: all 0.2s ease;
}

.preset-card.active {
  border-color: var(--brand-neon, #d4f826);
  background: #12130f;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.4);
}

.preset-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #1d1e24;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.preset-card.active .preset-icon-wrap {
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 20rpx rgba(212, 248, 38, 0.25);
}

.preset-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #f4f4f6;
  margin-bottom: 6rpx;
}

.preset-tag-text {
  font-size: 20rpx;
  color: #7a7a83;
}

.preset-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 描述词输入框 */
.prompt-box {
  padding: 20rpx 20rpx 14rpx;
  background: #0e0f12;
}

.prompt-textarea {
  width: 100%;
  height: 190rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #16171b;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 28rpx;
  color: #f4f4f6;
  caret-color: var(--brand-neon, #d4f826);
  line-height: 1.55;
  box-sizing: border-box;
}

.prompt-placeholder {
  color: #7a7a83;
  font-size: 26rpx;
}

.prompt-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding: 0 6rpx;
}

.word-counter {
  font-size: 22rpx;
  color: #7a7a83;
  font-variant-numeric: tabular-nums;
}

/* 快捷词胶囊 */
.quick-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.quick-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #141519;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 9999rpx;
  font-size: 24rpx;
  color: #c9c9d0;
  transition: all 0.15s ease;
}

.quick-pill:active {
  background: #1d1e24;
  transform: scale(0.97);
}

.quick-pill-text {
  font-weight: 500;
}

/* 底部操作条：悬浮在 TabBar 之上 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  padding: 0 32rpx;
  z-index: 900;
  box-sizing: border-box;
}

.bottom-bar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -20rpx;
  height: 260rpx;
  background: linear-gradient(180deg, rgba(7, 7, 9, 0) 0%, rgba(7, 7, 9, 0.92) 62%);
  z-index: -1;
  pointer-events: none;
}

.submit-btn {
  width: 100%;
}
