<view class="detail">
  <!-- 加载态：骨架，保持与成图同样的版式，避免一进来就整屏转圈 -->
  <block wx:if="{{loading}}">
    <view class="hero-sk"></view>
    <view class="sk-line" style="width: 62%; height: 40rpx; margin-top: 40rpx;"></view>
    <view class="sk-line" style="width: 100%;"></view>
    <view class="sk-line" style="width: 88%;"></view>
    <view class="sk-line" style="width: 72%;"></view>
  </block>

  <block wx:else>
    <!-- 范例图：贴边满宽，无卡面无阴影，图是主角 -->
    <view class="hero">
      <swiper
        class="hero-swiper"
        style="height: {{galleryHeightPx}}px;"
        current="{{galleryIndex}}"
        circular="{{galleryImages.length > 1}}"
        bindchange="onGalleryChange"
      >
        <swiper-item wx:for="{{galleryImages}}" wx:key="*this" class="hero-item">
          <image
            class="hero-img"
            src="{{item}}"
            mode="widthFix"
            data-index="{{index}}"
            bindload="onGalleryImageLoad"
            bindtap="onPreviewGallery"
          />
        </swiper-item>
      </swiper>

      <!-- 页码只在多图时出现 -->
      <view wx:if="{{galleryImages.length > 1}}" class="hero-count">{{galleryIndex + 1}} / {{galleryImages.length}}</view>

      <scroll-view
        wx:if="{{galleryImages.length > 1}}"
        scroll-x
        enable-flex
        class="hero-thumbs"
        show-scrollbar="{{false}}"
      >
        <view class="hero-thumbs-in">
          <image
            wx:for="{{galleryImages}}"
            wx:key="*this"
            class="thumb {{galleryIndex === index ? 'active' : ''}}"
            src="{{item}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPickGallery"
          />
        </view>
      </scroll-view>
    </view>

    <!-- 主体：一整块相纸，用留白与细线分组，不再拆成三张卡 -->
    <view class="body">
      <view wx:if="{{detail.author}}" class="byline">
        <image class="avatar" src="{{detail.author.avatar}}" mode="aspectFill" />
        <view class="byline-text">
          <text class="byline-name">{{detail.author.name}}</text>
          <text wx:if="{{metaDate}}" class="byline-meta">{{metaDate}} · YouMind</text>
        </view>
      </view>

      <text class="title">{{detail.title}}</text>

      <view wx:if="{{detail.tags && detail.tags.length}}" class="tags">
        <text wx:for="{{detail.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>

      <text wx:if="{{detail.description}}" class="desc">{{detail.description}}</text>

      <view class="rule"></view>

      <view class="block-head">
        <text class="block-title">提示词</text>
        <view class="copy" bindtap="onCopyPrompt" aria-role="button" aria-label="复制提示词">
          <t-icon name="file-copy" size="26rpx" color="#5c5145" />
          <text>复制</text>
        </view>
      </view>
      <scroll-view scroll-y class="prompt" enhanced show-scrollbar="{{false}}">
        <text class="prompt-body" selectable>{{detail.prompt}}</text>
      </scroll-view>
    </view>

    <view class="dockbar">
      <button class="btn btn--primary make" hover-class="none" bindtap="onMakeSame">
        {{detail.requiresImage ? '上传照片 · 做同款' : '做同款'}}
      </button>
    </view>
  </block>
</view>
