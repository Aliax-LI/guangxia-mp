<view wx:if="{{!rows.length}}" class="empty">
  <text class="title">直接说，或去做一张图</text>
  <text class="link" bindtap="onCreate">画图</text>
</view>

<view wx:else class="list">
  <block wx:for="{{rows}}" wx:key="id">
    <t-chat-message
      role="user"
      placement="right"
      variant="base"
      status="complete"
      content="{{item.userContent}}"
    />
    <t-chat-message
      role="assistant"
      placement="left"
      variant="base"
      status="{{item.assistantStatus}}"
      content="{{item.assistantContent}}"
      animation="dots"
    >
      <view wx:if="{{item.segments.length}}" slot="content" class="rich">
        <block wx:for="{{item.segments}}" wx:for-item="seg" wx:for-index="si" wx:key="si">
          <t-chat-markdown wx:if="{{seg.kind === 'md'}}" content="{{seg.text}}" />
          <view wx:elif="{{seg.kind === 'choices'}}" class="card">
            <text wx:if="{{seg.card.hint}}" class="hint">{{seg.card.hint}}</text>
            <view
              wx:for="{{seg.card.options}}"
              wx:for-item="opt"
              wx:key="value"
              class="choice {{item.pick === opt.value ? 'on' : ''}}"
              data-id="{{item.id}}"
              data-value="{{opt.value}}"
              bindtap="onPickChoice"
            >{{opt.label}}</view>
            <textarea
              wx:if="{{seg.card.placeholder}}"
              class="extra"
              placeholder="{{seg.card.placeholder}}"
              placeholder-class="extra-ph"
              data-id="{{item.id}}"
              value="{{item.detail}}"
              bindinput="onDetail"
              auto-height
              maxlength="200"
            />
            <view class="go" data-id="{{item.id}}" bindtap="onStartChoice">{{seg.card.button}}</view>
          </view>
        </block>
      </view>
      <view wx:elif="{{item.generating || item.showImages}}" slot="content" class="shots {{item.places.length > 1 || item.images.length > 1 ? 'many' : ''}}">
        <block wx:if="{{item.generating}}">
          <view wx:for="{{item.places}}" wx:for-item="place" wx:key="*this" class="shot wait">
            <view class="mist {{motion ? 'on' : ''}}"></view>
            <view class="glow {{motion ? 'on' : ''}}"></view>
            <view class="wait-copy">
              <text class="wait-pct">{{item.progress}}%</text>
              <text wx:if="{{item.model}}" class="wait-model">{{item.model}}</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <image
            wx:for="{{item.images}}"
            wx:for-item="src"
            wx:for-index="imgIndex"
            wx:key="imgIndex"
            class="shot photo"
            src="{{src}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            data-src="{{src}}"
            bindtap="onPreview"
          />
        </block>
      </view>
      <view wx:if="{{item.liveText}}" slot="actionbar" class="ink">
        <view class="ink-bar {{motion ? 'on' : ''}}"></view>
      </view>
      <view wx:if="{{item.status === 'error' || item.showImages}}" slot="actionbar" class="actions">
        <text wx:if="{{item.status === 'error'}}" class="act" data-id="{{item.id}}" bindtap="onRetry">重试</text>
        <text wx:if="{{item.showImages}}" class="act" data-id="{{item.id}}" bindtap="onSave">存作品集</text>
      </view>
    </t-chat-message>
  </block>
</view>
