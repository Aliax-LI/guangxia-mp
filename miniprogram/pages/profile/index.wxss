.profile-page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 用户头部信息区 */
.user-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 0;
}

.user-header-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.header-help-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f4f4f7;
}

.header-help-btn:active {
  opacity: 0.75;
}

.avatar-shell {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f3;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.user-avatar {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 140rpx !important;
  height: 140rpx !important;
  min-width: 140rpx !important;
  min-height: 140rpx !important;
  max-width: 140rpx !important;
  max-height: 140rpx !important;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
}

.avatar-hit::after {
  display: none;
  border: none;
}

.user-name-input {
  display: block;
  width: 100%;
  max-width: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  font-size: 40rpx;
  font-weight: 800;
  color: #111111;
  height: 56rpx;
  line-height: 56rpx;
  box-sizing: border-box;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: block;
  width: 100%;
}

.user-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #111111;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.id-text {
  font-size: 24rpx;
  color: #8e8e93;
}

.copy-icon {
  margin-left: 4rpx;
}

/* 账户概览卡片 */
.account-card {
  margin: 28rpx 28rpx 0;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #f7f7fa;
}

.stats-group {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-item {
  min-width: 0;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #111111;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: #6b6b70;
}

.profile-actions {
  margin-top: 26rpx;
}

.edit-btn {
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 2rpx solid #dcdce1;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #111111;
}

.edit-btn:active {
  background: #f2f2f5;
}

/* 签名行 */
.bio-row {
  padding: 24rpx 28rpx 0;
}

.bio-text {
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.4;
}

/* 快捷功能双卡片 */
.feature-dual-cards {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 28rpx 0;
}

.feature-card {
  flex: 1;
  background: #f4f4f7;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feat-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feat-text-box {
  flex: 1;
  min-width: 0;
}

.feat-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #111111;
}

.feat-sub {
  display: block;
  font-size: 20rpx;
  color: #8e8e93;
  margin-top: 4rpx;
}

/* 作品分类 Tab 栏 */
.works-tab-bar {
  display: flex;
  align-items: center;
  gap: 48rpx;
  padding: 32rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f3;
}

.works-tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.tab-title-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tab-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #8e8e93;
  transition: all 0.15s ease;
}

.works-tab-item.active .tab-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
}

.tab-line {
  position: absolute;
  bottom: -18rpx;
  width: 44rpx;
  height: 6rpx;
  border-radius: 9999rpx;
  background: #111111;
}

/* 九宫格方形作品集展示 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
  padding-top: 4rpx;
}

.work-grid-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: #ececf0;
  overflow: hidden;
}

.work-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 草稿箱蒙层 */
.draft-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #ffffff;
}

.draft-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.expand-icon-box {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-tab-box {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

/* 荧光绿悬浮加号 */
.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 10rpx 32rpx rgba(212, 248, 38, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  transition: transform 0.15s ease;
}

.fab-btn:active {
  transform: scale(0.92);
}

.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.privacy-card {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.privacy-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
  text-align: center;
}

.privacy-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #3a3a3c;
  line-height: 1.5;
}

.privacy-link {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #7ab800;
  text-align: center;
}

.privacy-actions {
  margin-top: 32rpx;
}

.privacy-agree-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
}

.privacy-agree-btn::after {
  display: none;
}

