<!--
  Primary: 当前会话消息流
  Secondary: 顶栏会话标题、历史抽屉
  Tertiary: 工具切换、画图参数
  One primary action: 发送
-->
<view class="home" style="{{keyboard ? 'padding-bottom:' + keyboard + 'px' : ''}}">
  <view class="topbar">
    <view class="topbar-btn" catchtap="onToggleHistory" aria-role="button" aria-label="会话历史">
      <t-icon name="view-list" size="40rpx" color="#F4F4F6" />
    </view>
    <view class="topbar-center">
      <text class="topbar-kind">{{tool === 'image' ? '画图' : '对话'}}</text>
      <text class="topbar-title">{{sessionTitle}}</text>
    </view>
    <view class="topbar-btn" catchtap="onNewSameKind" aria-role="button" aria-label="新建会话">
      <t-icon name="chat-add" size="40rpx" color="#F4F4F6" />
    </view>
  </view>

  <view wx:if="{{!turnCount}}" class="stage">
    <view class="hello-block">
      <text class="hello">{{tool === 'image' ? '描述画面，我来生成' : '有什么我能帮你的吗？'}}</text>
      <text class="hello-sub">{{tool === 'image' ? '每个画图会话独立保存' : '每个对话会话独立保存'}}</text>
    </view>
    <view wx:if="{{!keyboard}}" class="recs">
      <text class="recs-k">试试这些</text>
      <view
        wx:for="{{tool === 'image' ? imageIdeas : chatIdeas}}"
        wx:key="*this"
        class="idea"
        data-text="{{item}}"
        bindtap="onIdea"
      >{{item}}</view>
    </view>
  </view>

  <view wx:else class="thread">
    <conversation
      id="chat-conversation"
      bind:create="onOpenImage"
      bind:retry="onRetry"
      bind:preview="onPreview"
      bind:save="onSave"
      bind:choose="onChoose"
    />
  </view>

  <view wx:if="{{menuOpen || panelOpen || historyOpen}}" class="shade" catchtap="onClosePop"></view>

  <view class="drawer {{historyOpen ? 'open' : ''}}" catchtap="noop">
    <view class="drawer-head">
      <text class="drawer-title">会话</text>
      <view class="drawer-close" catchtap="onCloseHistory">
        <t-icon name="close" size="36rpx" color="#F4F4F6" />
      </view>
    </view>
    <view class="drawer-new">
      <view class="new-btn" data-kind="chat" catchtap="onNewSessionTap">
        <t-icon name="chat" size="32rpx" color="#F4F4F6" />
        <text>新对话</text>
      </view>
      <view class="new-btn" data-kind="image" catchtap="onNewSessionTap">
        <t-icon name="image" size="32rpx" color="#F4F4F6" />
        <text>新画图</text>
      </view>
    </view>
    <view
      class="drawer-clear {{turnCount ? '' : 'disabled'}}"
      catchtap="onClearCurrentSession"
      aria-role="button"
      aria-label="清空当前会话消息"
    >
      <t-icon name="clear" size="32rpx" color="{{turnCount ? '#F4F4F6' : '#5C5C65'}}" />
      <text>清空当前会话</text>
    </view>
    <scroll-view class="drawer-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="drawer-list-inner">
        <block wx:if="{{sessionRows.length}}">
          <view
            wx:for="{{sessionRows}}"
            wx:key="id"
            class="sess {{item.active ? 'on' : ''}}"
            data-id="{{item.id}}"
            catchtap="onPickSession"
          >
            <view class="sess-main">
              <text class="sess-kind">{{item.kindLabel}}</text>
              <text class="sess-title">{{item.title}}</text>
            </view>
            <view class="sess-side">
              <text class="sess-time">{{item.timeLabel}}</text>
              <view
                class="sess-del"
                data-id="{{item.id}}"
                catchtap="onDeleteSession"
                aria-role="button"
                aria-label="删除会话"
              >
                <t-icon name="delete" size="36rpx" color="#7A7A83" />
              </view>
            </view>
          </view>
        </block>
        <view wx:else class="drawer-empty">
          <text>还没有记录，发一条消息开始吧</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="dock">
    <view class="above">
      <view class="tool">
        <view class="chip" catchtap="onToggleMenu">
          <text>{{tool === 'image' ? '画图' : '对话'}}</text>
          <t-icon name="{{menuOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="#F4F4F6" />
        </view>
        <view wx:if="{{menuOpen}}" class="menu" catchtap="noop">
          <view class="menu-item {{tool === 'chat' ? 'on' : ''}}" data-tool="chat" catchtap="onPickTool">对话</view>
          <view class="menu-item {{tool === 'image' ? 'on' : ''}}" data-tool="image" catchtap="onPickTool">画图</view>
        </view>
      </view>
      <view wx:if="{{tool === 'image'}}" class="chip" catchtap="onTogglePanel">
        <text>{{ratioLabel}}</text>
        <t-icon name="{{panelOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="#F4F4F6" />
      </view>
      <scroll-view
        wx:if="{{refImages.length}}"
        class="ref-strip"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="ref-row">
          <view wx:for="{{refImages}}" wx:key="*this" class="thumb">
            <image class="thumb-img" src="{{item}}" mode="aspectFill" />
            <view class="thumb-x" data-index="{{index}}" catchtap="onRemoveRef">
              <t-icon name="close" size="20rpx" color="#ffffff" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{panelOpen}}" class="panel" catchtap="noop">
      <text class="k">模型</text>
      <view class="model">{{imageModel}}</view>

      <text class="k">质量</text>
      <view class="opts">
        <view
          wx:for="{{qualities}}"
          wx:key="id"
          class="opt {{quality === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-group="quality"
          catchtap="onPickOpt"
        >{{item.label}}</view>
      </view>

      <text class="k">数量</text>
      <view class="opts">
        <view
          wx:for="{{counts}}"
          wx:key="*this"
          class="opt {{count === item ? 'on' : ''}}"
          data-id="{{item}}"
          data-group="count"
          catchtap="onPickOpt"
        >{{item}}张</view>
      </view>

      <text class="k">比例</text>
      <view class="opts">
        <view
          wx:for="{{ratios}}"
          wx:key="id"
          class="opt {{ratioId === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-group="ratio"
          catchtap="onPickOpt"
        >{{item.label}}</view>
      </view>

      <text class="k">分辨率</text>
      <view class="opts">
        <view
          wx:for="{{resolutions}}"
          wx:key="id"
          class="opt {{resolution === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-group="resolution"
          catchtap="onPickOpt"
        >{{item.label}}</view>
      </view>
    </view>

      <t-chat-sender
        value="{{draft}}"
        placeholder="{{tool === 'image' ? '描述想生成的画面' : '发消息，可添加多张图片'}}"
        adjust-position="{{false}}"
        auto-rise-with-keyboard="{{false}}"
        render-presets="{{senderPresets}}"
        bind:change="onDraft"
        bind:send="onSend"
        bind:keyboardheightchange="onKeyboard"
      >
        <view slot="footer-prefix" class="bits">
          <view class="cam" catchtap="onCamera">
            <t-icon name="camera" size="40rpx" color="#F4F4F6" />
          </view>
          <view wx:if="{{canSend}}" class="side go" catchtap="onSendTap">
            <view class="go-icon">
              <t-icon name="send-filled" size="32rpx" color="#0A0B05" />
            </view>
          </view>
          <view wx:else class="side plus" catchtap="onAlbum">
            <t-icon name="add" size="40rpx" color="#F4F4F6" />
          </view>
        </view>
      </t-chat-sender>
  </view>

  <view wx:if="{{showPrivacyPanel}}" class="privacy-mask" catchtouchmove="true">
    <view class="privacy-card">
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-desc">{{privacyDesc}}</text>
      <text class="privacy-link" bindtap="onOpenPrivacyContract">查看隐私保护指引</text>
      <view class="privacy-actions">
        <button
          id="edit-agree-btn"
          class="privacy-agree-btn"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onPrivacyAgree"
        >
          同意并继续
        </button>
      </view>
    </view>
  </view>
</view>
