.editor-page {
  padding-top: 4rpx;
  padding-bottom: 240rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.editor-masthead {
  padding-bottom: 32rpx;
}

/* 影像工作室画布 */
.studio-canvas {
  position: relative;
  background: #000;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.canvas-image {
  width: 100%;
  display: block;
}

.canvas-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  color: #f4f4f6;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 10rpx var(--brand-neon, #d4f826);
}

/* 提示词卡片 */
.prompt-card {
  padding: 30rpx 30rpx 26rpx;
  background: #0e0f12;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.35);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.head-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.head-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: rgba(212, 248, 38, 0.1);
  border: 1rpx solid rgba(212, 248, 38, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.head-tip {
  font-size: 22rpx;
  color: #8a8a93;
}

.editor-textarea {
  width: 100%;
  height: 220rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #f4f4f6;
  caret-color: var(--brand-neon, #d4f826);
  background: #16171b;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.editor-placeholder {
  color: #7a7a83;
  font-size: 26rpx;
}

.textarea-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.counter {
  font-size: 22rpx;
  color: #7a7a83;
  font-variant-numeric: tabular-nums;
}

/* 底部操作条 */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(7, 7, 9, 0.92);
  backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  z-index: 100;
  box-sizing: border-box;
}

.gen-btn {
  width: 100%;
}
