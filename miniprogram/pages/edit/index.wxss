/* 对话 / 画图首页：消息流是唯一主角，输入坞和 TabBar 是两块固定基座 */
.home {
  box-sizing: border-box;
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: transparent;
  padding-bottom: calc(var(--tabbar-h, 132rpx) + env(safe-area-inset-bottom));
  overflow: hidden;
  /* 键盘高度由行内 style 注入，见 wxml；这里只做过渡，避免跳动 */
  transition: height 0.18s ease;
}

/* 键盘弹起：标签条被键盘盖住，不再给它留 132rpx 的空位 */
.home.kb-open {
  padding-bottom: 0;
}

/* 安全灯：右上角一盏琥珀色溢光，模拟暗房里唯一的光源 */
.home::before {
  content: '';
  position: absolute;
  top: -280rpx;
  right: -200rpx;
  width: 640rpx;
  height: 640rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 118, 27, 0.12) 0%, rgba(201, 118, 27, 0.03) 42%, rgba(201, 118, 27, 0) 70%);
  pointer-events: none;
  z-index: 0;
}

/* ── 顶栏：一条贯穿的分隔线收住页面顶端，不再是一块悬空的卡片 ── */

.nav {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 96rpx;
  padding: 0 var(--s2);
}

.nav-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.nav-title {
  max-width: 100%;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-hi);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-kind {
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: 3rpx;
  color: var(--text-low);
}

/* ── 空态：光匣取景徽记 + 能力胶囊 + 错峰入场起始句 ── */

@keyframes intro-rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes intro-halo {
  0%, 100% {
    opacity: 0.42;
    transform: scale(0.92);
  }
  50% {
    opacity: 0.92;
    transform: scale(1.08);
  }
}

@keyframes starter-dot {
  0%, 100% {
    opacity: 0.55;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.22);
  }
}

.intro {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--s3) var(--gutter) var(--s4);
}

.intro-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.intro-emblem {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin-bottom: var(--s3);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: intro-rise 360ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.intro-halo {
  position: absolute;
  inset: -24rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 118, 27, 0.2) 0%, rgba(201, 118, 27, 0.04) 50%, rgba(201, 118, 27, 0) 74%);
  animation: intro-halo 3.6s ease-in-out infinite;
  pointer-events: none;
}

.intro-card {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink-1);
  border: 1rpx solid var(--line);
  box-shadow: 0 10rpx 24rpx rgba(60, 45, 25, 0.07);
  transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
}

.intro-emblem.is-image .intro-card {
  transform: scale(1.02);
}

.intro-corner {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-color: rgba(201, 118, 27, 0.6);
  border-style: solid;
  border-width: 0;
  pointer-events: none;
}

.intro-corner.tl {
  top: 10rpx;
  left: 10rpx;
  border-top-width: 3rpx;
  border-left-width: 3rpx;
  border-top-left-radius: 3rpx;
}

.intro-corner.tr {
  top: 10rpx;
  right: 10rpx;
  border-top-width: 3rpx;
  border-right-width: 3rpx;
  border-top-right-radius: 3rpx;
}

.intro-corner.bl {
  bottom: 10rpx;
  left: 10rpx;
  border-bottom-width: 3rpx;
  border-left-width: 3rpx;
  border-bottom-left-radius: 3rpx;
}

.intro-corner.br {
  bottom: 10rpx;
  right: 10rpx;
  border-bottom-width: 3rpx;
  border-right-width: 3rpx;
  border-bottom-right-radius: 3rpx;
}

.intro-title {
  font-size: 48rpx;
  line-height: 1.22;
  font-weight: 800;
  letter-spacing: -1.4rpx;
  color: var(--text-hi);
  animation: intro-rise 380ms cubic-bezier(0.16, 1, 0.3, 1) 40ms both;
}

.intro-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-soft);
  animation: intro-rise 400ms cubic-bezier(0.16, 1, 0.3, 1) 90ms both;
}

.intro-caps {
  margin-top: var(--s3);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  animation: intro-rise 420ms cubic-bezier(0.16, 1, 0.3, 1) 140ms both;
}

.intro-cap {
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-mid);
}

.starters {
  margin-top: var(--s5);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.starters-label {
  margin-bottom: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--text-low);
  animation: intro-rise 420ms cubic-bezier(0.16, 1, 0.3, 1) 170ms both;
}

/* 示例卡片行：暖白相纸卡片 + 呼吸琥珀点 + 轻箭头 + 按压缩放 */
.starter {
  display: flex;
  align-items: center;
  gap: var(--s3);
  min-height: 96rpx;
  padding: 0 var(--s3);
  border-radius: 22rpx;
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
  box-shadow: 0 4rpx 14rpx rgba(60, 45, 25, 0.04);
  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  animation: intro-rise 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.starter.s-0 { animation-delay: 200ms; }
.starter.s-1 { animation-delay: 260ms; }
.starter.s-2 { animation-delay: 320ms; }

.starter:active {
  transform: scale(0.985);
  background: var(--ink-2);
  border-color: var(--line);
}

.starter-mark {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-neon);
  flex-shrink: 0;
  animation: starter-dot 2.8s ease-in-out infinite;
}

.starter.s-1 .starter-mark { animation-delay: 0.4s; }
.starter.s-2 .starter-mark { animation-delay: 0.8s; }

.starter-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--text-hi);
}

@media (prefers-reduced-motion: reduce) {
  .intro-emblem,
  .intro-halo,
  .intro-title,
  .intro-sub,
  .intro-caps,
  .starters-label,
  .starter,
  .starter-mark {
    animation: none;
  }
}

/* ── 线程 ─────────────────────────────────────────────── */

.thread {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

conversation {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-height: 0;
}

/* ── 遮罩 & 抽屉 ──────────────────────────────────────── */

.scrim {
  position: fixed;
  inset: 0;
  z-index: 1100;
  background: rgba(28, 24, 21, 0.36);
}

.scrim.scrim--clear {
  background: transparent;
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 600rpx;
  max-width: 88vw;
  z-index: 1102;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding-top: calc(env(safe-area-inset-top) + var(--s2));
  background: var(--ink-1);
  border-right: 1rpx solid var(--line-weak);
  transform: translateX(-102%);
  transition: transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
}

.drawer.open {
  transform: translateX(0);
  box-shadow: 24rpx 0 72rpx rgba(60, 45, 25, 0.6);
}

.drawer-hd {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s2) var(--s4) var(--s2) var(--s4);
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  color: var(--text-hi);
}

.drawer-acts {
  flex-shrink: 0;
  display: flex;
  gap: var(--s2);
  padding: 0 var(--s4) var(--s3);
}

.drawer-new {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: var(--r-card);
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-hi);
}

.drawer-new:active {
  background: var(--ink-3);
}

.drawer-clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 var(--s4) var(--s2);
  padding: 20rpx var(--s3);
  border-radius: var(--r-inset);
  font-size: 25rpx;
  color: var(--text-mid);
}

.drawer-clear:active {
  background: var(--fill-hover);
}

.drawer-clear.off {
  opacity: 0.45;
  pointer-events: none;
}

.drawer-list {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.drawer-list-in {
  padding: 0 var(--s3) calc(var(--s4) + env(safe-area-inset-bottom));
}

.sess {
  display: flex;
  align-items: center;
  gap: var(--s2);
  padding: var(--s2) var(--s2) var(--s2) var(--s3);
  margin-bottom: 4rpx;
  border-radius: var(--r-card);
}

.sess.on {
  background: var(--ink-2);
}

.sess-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sess-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-mid);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sess.on .sess-title {
  color: var(--text-hi);
  font-weight: 600;
}

.sess-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: var(--text-low);
}

.sess.on .sess-kind {
  color: var(--brand-neon);
}

.sess-del {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
}

.sess-del:active {
  background: var(--fill-active);
}

.drawer-empty {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: var(--s5) var(--s3);
  font-size: 26rpx;
  color: var(--text-mid);
}

.drawer-empty-sub {
  font-size: 23rpx;
  color: var(--text-low);
}

/* ── 输入坞：参数条 + 一个完整的输入块，两者共用同一条左基线 ── */

.dock {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  padding: 0 var(--gutter) var(--s2);
}

.dock.menu-open {
  z-index: 1101;
}

.param-pop {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.param-pop-in {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: var(--ink-1);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 24rpx rgba(60, 45, 25, 0.12);
}

.param-pop-item {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  color: var(--text-mid);
}

.param-pop-item.on {
  background: #f8ede0;
  color: var(--text-hi);
  font-weight: 600;
}

.dock-params {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.dock-params-in {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.chip.param-chip {
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: var(--ink-2);
  border-color: transparent;
  font-size: 23rpx;
  font-weight: 500;
}

.chip.param-chip.active {
  background: #f8ede0;
  border-color: rgba(201, 118, 27, 0.45);
}

.chip.param-chip.open {
  border-color: var(--brand-neon);
}

.param-k {
  color: var(--text-soft);
}

.param-v {
  color: var(--text-hi);
  font-weight: 600;
}

/* 参数条：无底色、无边框，靠字距和分隔点分组，不与输入框抢层级 */
.dock-bar {
  display: flex;
  align-items: center;
  gap: var(--s2);
  height: 72rpx;
  padding-left: 4rpx;
}

.dock-spacer {
  flex: 1;
  min-width: 0;
}

/* 字数：只在接近上限时出现，等宽数字不跳动 */
.count {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--text-low, #8b7f70);
  font-variant-numeric: tabular-nums;
}

.count.over {
  color: var(--danger, #c0392b);
}

/* 收起键盘：与参数胶囊同高，靠右 */
.kb-hide {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line-weak);
}

.kb-hide:active {
  background: var(--fill-hover);
}

.tool {
  position: relative;
  flex-shrink: 0;
}

.chip {
  height: 56rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border-radius: var(--r-pill);
  background: transparent;
  border: 1rpx solid var(--line-weak);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-mid);
}

.chip:active {
  background: var(--fill-hover);
}

.chip-sep {
  color: var(--text-low);
  font-weight: 400;
}

/* 参考图缩略：放进参数条右端，不挤占输入框 */
.ref-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.ref {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
}

.ref-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ref-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 26rpx;
  height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 8rpx;
  background: rgba(60, 45, 25, 0.72);
}

/* 输入块：一个整体，相机 / 文字 / 发送 三点等距，全部垂直居中 */
.composer {
  position: relative;
}

.composer-in {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  min-height: 104rpx;
  padding: 14rpx 10rpx 14rpx 6rpx;
  border-radius: 32rpx;
  background: var(--ink-2);
  border: 1rpx solid var(--line);
}

.composer-cam {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-end;
  border-radius: 50%;
}

.composer-cam:active {
  background: var(--fill-hover);
}

.composer-input {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  max-height: 216rpx;
  overflow: hidden;
}

/* 文字区：竖直方向从顶部起排，超过 4 行在内部滚动，输入块不再无限长高 */
.composer .t-chat-sender__textarea {
  max-height: 216rpx;
  overflow: hidden;
}

.composer .t-chat-sender__textarea--control {
  max-height: 216rpx;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 16rpx 0 !important;
}

.composer-actions {
  flex-shrink: 0;
  align-self: flex-end;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.composer-end {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.16s ease, transform 0.16s ease;
}

.composer-end:active {
  transform: scale(0.94);
}

.composer-end.plus {
  background: var(--ink-3);
}

.composer-end.plus:active {
  background: var(--ink-4);
}

.composer-end.go {
  background: var(--brand-neon);
  box-shadow: 0 6rpx 16rpx rgba(201, 118, 27, 0.22);
}

.composer-end.go:active {
  background: var(--brand-neon-active);
}

/* 向上箭头：用一个伪元素画「↑」的斜臂 + 一根竖杆，
   全部是实心边框，不依赖字体图标、不依赖内联 SVG（WXML 会吞掉 SVG 标签）。 */
.send-arrow {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

/* 竖杆 */
.send-arrow::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 4rpx;
  width: 4rpx;
  height: 22rpx;
  border-radius: 2rpx;
  background: #fffdf9;
}

/* 箭头两臂：一个 45° 旋转的缺角方块 */
.send-arrow::after {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #fffdf9;
  border-top: 4rpx solid #fffdf9;
  border-top-left-radius: 3rpx;
  transform: rotate(45deg);
  transform-origin: center;
  box-sizing: border-box;
}

.menu {
  position: absolute;
  left: 0;
  bottom: 76rpx;
  z-index: 2;
  width: 220rpx;
  padding: 8rpx;
  border-radius: var(--r-card);
  background: var(--ink-1);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-float);
}

.menu-item {
  height: 80rpx;
  padding: 0 var(--s2);
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: var(--r-inset);
  font-size: 27rpx;
  color: var(--text-mid);
}

.menu-item.on {
  background: var(--ink-3);
  color: var(--text-hi);
  font-weight: 600;
}

.refs {
  flex: 1;
  min-width: 0;
  max-width: 440rpx;
}

.refs-in {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.ref {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: var(--r-inset);
  overflow: hidden;
  border: 1rpx solid var(--line);
}

.ref-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ref-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 10rpx;
  background: rgba(60, 45, 25, 0.72);
}



.p-v {
  font-size: 25rpx;
  color: var(--text-hi);
}

.p-half {
  display: flex;
  gap: var(--s3);
}

.p-col {
  flex: 1;
  min-width: 0;
}

/* ── TDesign chat-sender：只留文字区域，外壳交给 .composer-in ──
   把组件自身的内边距、边框、背景全部压平，否则会看到「框里还有框」。 */

.composer .t-chat-sender {
  margin: 0 !important;
  padding: 0 !important;
  min-height: 76rpx;
  max-height: 216rpx;
  border: none !important;
  border-radius: 0;
  background: transparent !important;
  box-shadow: none !important;
}

.composer .t-chat-sender__header,
.composer .t-chat-sender__footer {
  display: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

.composer .t-chat-sender__actions {
  flex-direction: row !important;
  align-items: center !important;
  padding: 0 !important;
  margin: 0 !important;
  gap: 0 !important;
}

.composer .t-chat-sender__mode,
.composer .t-chat-sender__sendbtn {
  display: none !important;
}

.composer .t-chat-sender__textarea {
  flex: 1;
  min-width: 0;
  min-height: 76rpx !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
}

.composer .t-chat-sender__textarea--control {
  min-height: 44rpx !important;
  padding: 0 !important;
  font-size: 28rpx !important;
  line-height: 44rpx !important;
  color: var(--text-hi, #1c1815) !important;
  caret-color: var(--brand-neon, #c9761b);
}

.composer .t-chat-sender__textarea--placeholder {
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  line-height: 44rpx;
  color: var(--text-low, #8b7f70) !important;
}

/* ── TDesign chat-message 覆写：统一宽度与换行 ────────── */

.t-chat-message {
  max-width: 100%;
  min-width: 0;
  margin-bottom: var(--s3);
  overflow: hidden;
}

.home .t-chat-message .t-chat-message__content {
  min-width: 0 !important;
  max-width: 100%;
  overflow: hidden;
}

.home .t-chat-content,
.home .t-chat-markdown,
.home .t-chat-markdown-p,
.home .t-chat-markdown-h,
.home .t-chat-markdown-h1,
.home .t-chat-markdown-h2,
.home .t-chat-markdown-h3,
.home .t-chat-markdown-list,
.home .t-chat-markdown-list-item {
  max-width: 100% !important;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.home .t-chat-markdown-h1 {
  font-size: 38rpx;
}

.home .t-chat-markdown-h2 {
  font-size: 34rpx;
}

.home .t-chat-markdown-h3 {
  font-size: 30rpx;
}

.home .t-chat-markdown-code,
.home .t-chat-markdown-table {
  max-width: 100%;
}

.home .t-chat-markdown-code__content {
  width: 100% !important;
  max-width: 100%;
  white-space: normal !important;
}

.home .t-chat-markdown-code__text {
  display: block !important;
  white-space: pre-wrap !important;
  word-break: break-all !important;
  overflow-wrap: anywhere !important;
}

.home .t-chat-markdown-table__container {
  max-width: 100% !important;
  white-space: normal !important;
}

.t-chat-message .t-chat-message__content--base {
  padding-top: 0;
}

.t-chat-message.right .t-chat-content,
.t-chat-message.user .t-chat-content,
.t-chat-message--base.right .t-chat-content {
  background: var(--ink-3);
  color: var(--text-hi);
}

.t-chat-message--base.assistant .t-chat-content,
.t-chat-message--base.left .t-chat-content {
  background: transparent;
  padding: 0;
  color: var(--text-hi);
  line-height: 1.6;
}

.t-chat-message--base.assistant .t-chat-content__assistant,
.t-chat-message--base.left .t-chat-content__assistant {
  color: var(--text-hi);
}

.t-chat-loading__moving--left,
.t-chat-loading__moving--right,
.t-chat-loading__moving--top {
  background-color: var(--brand-neon);
}

/* 原生输入保持挂载，焦点由页面管理，避免第二轮空占位挡住点击。 */
.composer-textarea {
  box-sizing: border-box;
  width: 0;
  min-height: 76rpx;
  max-height: 216rpx;
  padding: 16rpx 0;
  overflow-y: auto;
  font-size: 28rpx;
  line-height: 44rpx;
  color: var(--text-hi);
}
.composer-placeholder { color: var(--text-soft); }
.composer-end.busy { background: var(--ink-3); box-shadow: none; }
.composer-end.stop { background: var(--ink-3); border: 1rpx solid var(--line-strong); }
.composer-end.stop:active { background: var(--ink-4); }
.stop-square { width: 22rpx; height: 22rpx; border-radius: 5rpx; background: var(--text-hi); }
.generating-note { display: block; padding: 8rpx 4rpx 16rpx; color: var(--text-soft); font-size: 23rpx; line-height: 1.5; }
.ref-strip { display: block; width: 100%; height: 112rpx; white-space: nowrap; }
.ref-strip-in { display: inline-flex; gap: 16rpx; padding: 6rpx 0 14rpx; }
.ref-strip .ref { width: 88rpx; height: 88rpx; overflow: visible; }
.ref-strip .ref-img { border-radius: 16rpx; }
.ref-strip .ref-x { width: 44rpx; height: 44rpx; background: var(--ink-1); border-radius: 50%; top: -4rpx; right: -8rpx; }
@keyframes panel-slide-up {
  from {
    opacity: 0;
    transform: translateY(48rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.panel {
  position: fixed;
  z-index: 1101;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--ink-1);
  box-shadow: 0 -16rpx 44rpx rgba(60, 45, 25, 0.14);
  animation: panel-slide-up 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.panel-handle {
  width: 60rpx;
  height: 6rpx;
  margin: 0 auto 4rpx;
  border-radius: var(--r-pill);
  background: var(--line-strong);
  opacity: 0.45;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
}

.panel-head-text {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-hi);
}

.panel-summary {
  font-size: 21rpx;
  color: var(--text-soft);
  font-variant-numeric: tabular-nums;
}

.panel-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: -14rpx;
  border-radius: 50%;
}

.panel-close:active {
  background: var(--fill-hover);
}

.panel-body {
  max-height: 54vh;
}

.panel-sec {
  padding-bottom: 4rpx;
}

.panel .p-k {
  color: #5c5145;
  font-size: 23rpx;
  font-weight: 600;
}

.panel .p-k--block {
  display: block;
  margin: 14rpx 0 8rpx;
}

.panel .pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.panel .pill {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  border: 1rpx solid var(--line);
  color: var(--text-mid);
  background: var(--ink-1);
  transition: transform 140ms ease, background-color 160ms ease, border-color 160ms ease;
}

.panel .pill:active {
  transform: scale(0.975);
}

.panel .pill--on {
  color: var(--text-hi);
  background: var(--safelight-soft, rgba(201, 118, 27, 0.12));
  border-color: var(--brand-neon);
  font-weight: 700;
}

.panel .ratio-options {
  gap: 8rpx;
}

.panel .ratio-tile {
  flex: 1;
  min-width: 0;
  min-height: 112rpx;
  padding: 10rpx 4rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  border-radius: 16rpx;
  background: #f8f4ed;
  border-color: transparent;
}

.panel .ratio-tile.pill--on {
  background: #f8ede0;
  border-color: #c9761b;
}

.ratio-preview {
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ratio-shape {
  box-sizing: border-box;
  border: 2rpx solid #86786a;
  border-radius: 4rpx;
}

.pill--on .ratio-shape {
  border-color: #a85f11;
}

.ratio-auto { width: 34rpx; height: 34rpx; border-style: dashed; }
.ratio-square { width: 34rpx; height: 34rpx; }
.ratio-portrait { width: 26rpx; height: 38rpx; }
.ratio-landscape { width: 38rpx; height: 26rpx; }

.ratio-name {
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.25;
}

.ratio-size {
  color: #6f6355;
  font-size: 18rpx;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.panel .count-options,
.panel .quality-options {
  padding: 5rpx;
  gap: 4rpx;
  border-radius: 16rpx;
  background: var(--ink-2);
}

.panel .count-options .pill,
.panel .quality-options .pill {
  flex: 1;
  min-height: 66rpx;
  border: 0;
  background: transparent;
  color: #5c5145;
  border-radius: 12rpx;
}

.panel .count-options .pill--on,
.panel .quality-options .pill--on {
  color: #1c1815;
  background: #fffdf9;
  box-shadow: 0 2rpx 8rpx rgba(60, 45, 25, 0.12);
}

.model-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
}

.model-row:active {
  background: var(--ink-3);
}

.model-row-val {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.model-row-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-hi);
}

.model-list {
  margin-top: 8rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
}

.model-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-mid);
}

.model-opt.on {
  background: #fffdf9;
  color: var(--text-hi);
  font-weight: 600;
}

.panel-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line-weak);
}

.panel-reset,
.panel-done {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: 16rpx;
  transition: transform 140ms ease, background-color 160ms ease;
}

.panel-reset {
  width: 164rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-mid);
  background: var(--ink-2);
}

.panel-reset:active {
  transform: scale(0.98);
  background: var(--ink-3);
}

.panel-done {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-1);
  background: var(--brand-neon);
  box-shadow: 0 8rpx 20rpx rgba(201, 118, 27, 0.22);
}

.panel-done:active {
  transform: scale(0.985);
  background: var(--brand-neon-active);
}

@media (prefers-reduced-motion: reduce) {
  .panel {
    animation: none;
  }
}
