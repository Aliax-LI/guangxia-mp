:host {
  --message-image-width: 320rpx;
  position: relative;
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-height: 0;
}

.latest {
  position: absolute;
  right: 32rpx;
  bottom: 16rpx;
  min-height: 80rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  border-radius: 40rpx;
  background: var(--ink-1, #fffdf9);
  border: 1rpx solid var(--line);
  color: var(--text-mid);
  font-size: 24rpx;
}

/* 对话流：用户靠右成组，助手左对齐无气泡，靠墨色块与留白区分 */
.thread-scroll {
  width: 100%;
  height: 100%;
}

.list {
  width: 100%;
  padding: var(--s2) var(--gutter) var(--s4);
}

.turn {
  display: flex;
  flex-direction: column;
  gap: var(--s2);
  margin-bottom: var(--s5);
}

/* ── 用户侧 ───────────────────────────────────────────── */

.turn-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  max-width: 100%;
}

.user-media {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  max-width: 560rpx;
}

.user-img {
  width: var(--message-image-width, 320rpx);
  height: var(--message-image-width, 320rpx);
  border-radius: var(--r-inset);
  background: var(--ink-2);
}

.user-media.many .user-img {
  width: 176rpx;
  height: 176rpx;
}

.user-bubble {
  max-width: 560rpx;
  padding: 18rpx var(--s3);
  border-radius: var(--r-card) var(--r-inset) var(--r-card) var(--r-card);
  background: var(--ink-3);
  border: 1rpx solid var(--line-weak);
}

.user-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-hi);
  word-break: break-word;
}

/* ── 错误 ─────────────────────────────────────────────── */

.turn-assist {
  display: block;
  width: 100%;
  max-width: 100%;
}

.turn-assist.err {
  align-self: flex-start;
  max-width: 560rpx;
  padding: 20rpx var(--s3) 16rpx;
  border-radius: var(--r-inset) var(--r-card) var(--r-card) var(--r-card);
  background: var(--ink-2);
  border: 1rpx solid rgba(224, 90, 74, 0.3);
}

.err-mark {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.err-msg {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.55;
  color: var(--text-hi);
}

.err-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  height: 64rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-pill);
  background: transparent;
  border: 1rpx solid var(--line-strong);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-hi);
}

.err-retry:active {
  background: var(--fill-hover);
}

/* ── 生成中 / 成片 ────────────────────────────────────── */

.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shot {
  width: 440rpx;
  max-width: 100%;
  height: 540rpx;
  border-radius: var(--r-card);
  background: var(--ink-2);
}

.shots.many .shot {
  width: 292rpx;
  height: 376rpx;
}

.generation-content { position: relative; }
.generation-status { display: flex; align-items: center; gap: 12rpx; max-width: 100%; margin: 0 0 18rpx; color: #5c5145; font-size: 24rpx; line-height: 1.5; }
.status-dot { width: 10rpx; height: 10rpx; flex-shrink: 0; border-radius: 50%; background: #c9761b; }
.generation-label { color: #1c1815; font-weight: 600; }
.generation-duration { align-self: center; color: #6f6355; font-size: 22rpx; font-variant-numeric: tabular-nums; }

/* 固定点阵 + 移动亮度，中央计时不随动画位移。 */
.wait-surface {
  position: relative;
  width: 560rpx;
  max-width: 100%;
  height: auto;
  display: block;
  overflow: hidden;
  border-radius: var(--r-inset, 20rpx);
  background: #faf6ef;
}
.wait-surface::before {
  content: '';
  display: block;
  padding-top: var(--wait-padding, 100%);
}
.wait-glow, .wait-dots, .wait-dot-wave {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.wait-glow {
  background: radial-gradient(ellipse at 50% 50%, rgba(223, 172, 101, 0.32), rgba(223, 172, 101, 0) 70%);
  opacity: 0.45;
}
.wait-glow.on { animation: dot-glow 4.8s ease-in-out infinite; }
.wait-dots {
  background-image: radial-gradient(circle, rgba(168, 95, 17, 0.32) 1.5rpx, transparent 1.8rpx);
  background-size: 20rpx 20rpx;
  opacity: 0.5;
}
.wait-dots.on { animation: dot-breathe 4.8s ease-in-out infinite; }
.wait-dot-wave {
  right: auto;
  width: 50%;
  background-image: radial-gradient(circle, #b56a1b 2.4rpx, transparent 2.8rpx);
  background-size: 20rpx 20rpx;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%, #000 60%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 40%, #000 60%, transparent);
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  opacity: 0.7;
}
.wait-dot-wave.on { animation: dot-travel 2.8s ease-in-out infinite; }
.wait-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 100%;
  max-width: 100%;
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(ellipse, #faf6ef 10%, rgba(250, 246, 239, 0.96) 26%, rgba(250, 246, 239, 0) 58%);
  pointer-events: none;
}
.wait-time-label { color: #6f6355; font-size: 22rpx; line-height: 1.5; }
.wait-elapsed {
  display: block;
  margin: 4rpx 0 12rpx;
  color: #1c1815;
  font-size: 58rpx;
  line-height: 1.15;
  font-weight: 600;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}
.wait-stage {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5c5145;
}
.wait-activity { display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 12rpx; margin-top: 14rpx; }
.activity-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #b56a1b; opacity: 0.35; }
.activity-dot.on { animation: activity-breathe 1.2s ease-in-out infinite; }
.activity-dot.a1 { animation-delay: 0.16s; }
.activity-dot.a2 { animation-delay: 0.32s; }
.wait-batch { position: absolute; top: 8rpx; right: 10rpx; z-index: 2; color: #6f6355; font-size: 18rpx; }
@keyframes dot-glow {
  0%, 100% { opacity: 0.3; transform: scale(0.88); }
  50% { opacity: 1; transform: scale(1.12); }
}
@keyframes dot-breathe {
  0%, 100% { opacity: 0.28; }
  50% { opacity: 0.85; }
}
@keyframes dot-travel {
  0% { transform: translateX(-100%); opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { transform: translateX(200%); opacity: 0; }
}
@keyframes activity-breathe {
  0%, 70%, 100% { opacity: 0.25; transform: scale(0.8); }
  35% { opacity: 1; transform: scale(1.35); }
}

.shot.photo {
  animation: develop-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.shot.photo:active {
  opacity: 0.88;
}

@keyframes develop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ink {
  from { transform: scaleX(0.45); opacity: 0.45; }
  to { transform: scaleX(1); opacity: 1; }
}

@keyframes think-pulse {
  0%,
  100% {
    opacity: 0.22;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.15);
  }
}

.ink {
  display: flex;
  align-items: center;
  height: 20rpx;
}

.ink-bar {
  width: 40rpx;
  height: 6rpx;
  border-radius: var(--r-pill);
  background: var(--brand-neon);
  transform-origin: left center;
  transform: scaleX(0.45);
  opacity: 0.5;
}

.ink-bar.on {
  animation: ink 900ms cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
}

/* 成片后的动作条：轻量文字按钮，不与页面级主操作抢琥珀实心 */
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s3);
}

.chip-act {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 4rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-mid, #5c5145);
}

.chip-act:active {
  opacity: 0.6;
}

.chip-act.done {
  color: var(--text-low, #8b7f70);
  font-weight: 500;
}

.chip-act.done text {
  color: var(--text-low, #8b7f70);
}

/* ── 助手文本 ─────────────────────────────────────────── */

.rich {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
  padding: 18rpx var(--s3) 20rpx;
  border-radius: var(--r-inset) var(--r-card) var(--r-card) var(--r-card);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
  color: var(--text-hi);
}

/* 等待首 token：与助手气泡同形，弱层级 */
.think {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 560rpx;
  padding: 18rpx var(--s3);
  border-radius: var(--r-inset) var(--r-card) var(--r-card) var(--r-card);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
}

.think-label {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-mid);
}

.think-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.think-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-neon);
  opacity: 0.28;
}

.think-dot.on {
  animation: think-pulse 900ms ease-in-out infinite;
}

.think-dot.d1.on {
  animation-delay: 160ms;
}

.think-dot.d2.on {
  animation-delay: 320ms;
}

/* ── GenUI 选项卡 ─────────────────────────────────────── */

.card {
  margin-top: var(--s3);
  padding: var(--s3);
  border-radius: var(--r-inset);
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
}

.hint {
  display: block;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-low);
}

.choice {
  margin-top: 12rpx;
  padding: 18rpx var(--s3);
  border-radius: var(--r-inset);
  border: 1rpx solid var(--line);
  font-size: 27rpx;
  line-height: 1.45;
  color: var(--text-hi);
}

.choice.on {
  background: var(--brand-neon);
  border-color: var(--brand-neon);
  color: var(--brand-neon-ink);
  font-weight: 700;
}

.extra {
  width: 100%;
  margin-top: var(--s2);
  min-height: 92rpx;
  padding: 16rpx var(--s2);
  border-radius: var(--r-inset);
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
  font-size: 27rpx;
  line-height: 1.45;
  color: var(--text-hi);
  caret-color: var(--brand-neon);
}

.extra-ph {
  color: var(--text-low);
}

.go {
  margin-top: var(--s2);
  height: 80rpx;
  border-radius: var(--r-pill);
  background: var(--brand-neon);
  color: var(--brand-neon-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
}

.go:active {
  background: var(--brand-neon-active);
}

.copy-act {
  display: inline-flex;
  align-items: center;
  margin-top: var(--s2);
  padding: 12rpx var(--s3);
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-hi);
}

.copy-act:active {
  background: var(--fill-hover);
}

/* ── 空态 ─────────────────────────────────────────────── */

.empty {
  padding: 14vh var(--gutter) var(--s5);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
}

.empty-title {
  margin-top: var(--s3);
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.3;
  color: var(--text-hi);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--text-soft);
}

.empty-act {
  margin-top: var(--s4);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 var(--s4);
  border-radius: var(--r-pill);
  background: var(--brand-neon);
  color: var(--brand-neon-ink);
  font-size: 27rpx;
  font-weight: 700;
}

/* ── 降级：系统要求减少动效 ───────────────────────────── */

@media (prefers-reduced-motion: reduce) {
  .wait-glow.on,
  .wait-dots.on,
  .wait-dot-wave.on,
  .activity-dot.on,
  .ink-bar.on,
  .think-dot.on,
  .shot.photo {
    animation: none;
  }

  .think-dot {
    opacity: 0.5;
  }

  .ink-bar {
    transform: none;
    opacity: 1;
  }
}
