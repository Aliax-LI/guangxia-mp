:host {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.thread-scroll {
  width: 100%;
  height: 100%;
}

.empty {
  padding: 18vh 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-hi, #f4f4f6);
}

.link {
  margin-top: 24rpx;
  padding-bottom: 4rpx;
  border-bottom: 6rpx solid var(--brand-neon, #d4f826);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-hi, #f4f4f6);
}

.list {
  width: 100%;
  padding: 12rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.turn {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.turn-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  max-width: 100%;
}

.user-media {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  max-width: 560rpx;
}

.user-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 20rpx;
  background: var(--ink-2, #16171b);
}

.user-media.many .user-img {
  width: 176rpx;
  height: 176rpx;
}

.user-bubble {
  max-width: 560rpx;
  padding: 18rpx 28rpx;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  background: var(--ink-3, #1d1e24);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  box-sizing: border-box;
}

.user-text {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  color: var(--text-hi, #f4f4f6);
  word-break: break-word;
}

.turn-assist {
  display: block;
  width: 100%;
  max-width: 100%;
}

.turn-assist.err {
  align-self: flex-start;
  max-width: 560rpx;
  padding: 20rpx 24rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--ink-2, #16171b);
  border: 1rpx solid rgba(255, 92, 87, 0.32);
  box-sizing: border-box;
}

.err-msg {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  color: #f4f4f6;
}

.err-retry {
  margin-top: 16rpx;
  align-self: flex-start;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line-strong, rgba(255, 255, 255, 0.16));
  background: transparent;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hi, #f4f4f6);
  box-sizing: border-box;
}

.err-retry:active {
  background: rgba(255, 255, 255, 0.06);
}

.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shot {
  width: 420rpx;
  max-width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  background: var(--ink-2, #16171b);
}

.shots.many .shot {
  width: 280rpx;
  height: 360rpx;
}

.shot.wait {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #101014;
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
}

.mist {
  position: absolute;
  top: -40%;
  left: -50%;
  width: 220%;
  height: 220%;
  background: linear-gradient(
    120deg,
    #101014 0%,
    #191a12 24%,
    rgba(212, 248, 38, 0.16) 48%,
    #191a12 72%,
    #101014 100%
  );
}

.mist.on {
  animation: drift 2.6s ease-in-out infinite alternate;
}

.glow {
  position: absolute;
  top: -10%;
  bottom: -10%;
  left: 0;
  width: 46%;
  background: linear-gradient(90deg, rgba(212, 248, 38, 0), rgba(212, 248, 38, 0.22), rgba(212, 248, 38, 0));
  transform: translateX(-140%);
}

.glow.on {
  animation: wash 2.2s ease-in-out infinite;
}

.wait-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wait-pct {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.96);
  font-variant-numeric: tabular-nums;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.6);
}

.wait-model {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.7);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}

.shot.photo {
  animation: develop-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.ring {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-hole {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ink-0, #070709);
}

.wait-t {
  position: relative;
  z-index: 1;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-neon, #d4f826);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--brand-neon-ink, #0a0b05);
}

.ink {
  display: flex;
  align-items: center;
  height: 20rpx;
}

.ink-bar {
  width: 36rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--brand-neon, #d4f826);
  transform-origin: left center;
  transform: scaleX(0.45);
  opacity: 0.5;
}

.ink-bar.on {
  animation: ink 900ms cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
}

@keyframes drift {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-22%, -12%, 0); }
}

@keyframes wash {
  from { transform: translateX(-140%); }
  to { transform: translateX(280%); }
}

@keyframes develop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ink {
  from { transform: scaleX(0.45); opacity: 0.45; }
  to { transform: scaleX(1); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .mist.on,
  .glow.on,
  .ink-bar.on,
  .think-dot.on,
  .shot.photo {
    animation: none;
  }

  .think-dot {
    opacity: 0.5;
  }

  .ink-bar {
    transform: none;
    opacity: 1;
  }
}

.actions {
  display: flex;
  gap: 28rpx;
}

.act {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hi, #f4f4f6);
  padding-bottom: 2rpx;
  border-bottom: 4rpx solid var(--brand-neon, #d4f826);
}

.rich {
  max-width: 100%;
  box-sizing: border-box;
  overflow-wrap: anywhere;
  word-break: break-word;
  padding: 20rpx 28rpx 24rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  color: var(--text-hi, #f4f4f6);
}

/* 等待首 token：与助手气泡同形，弱层级，不用全宽 TDesign pending */
.think {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  max-width: 560rpx;
  padding: 18rpx 28rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  box-sizing: border-box;
}

.think-label {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  color: var(--text-mid, #a2a2ab);
}

.think-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.think-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  opacity: 0.28;
}

.think-dot.on {
  animation: think-pulse 900ms ease-in-out infinite;
}

.think-dot.d1.on {
  animation-delay: 160ms;
}

.think-dot.d2.on {
  animation-delay: 320ms;
}

@keyframes think-pulse {
  0%,
  100% {
    opacity: 0.22;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.15);
  }
}

.card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--ink-1, #0e0f12);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  box-sizing: border-box;
}

.hint {
  display: block;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-low, #8a8a93);
}

.choice {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: transparent;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--text-hi, #f4f4f6);
}

.choice.on {
  background: var(--brand-neon, #d4f826);
  border-color: var(--brand-neon, #d4f826);
  color: var(--brand-neon-ink, #0a0b05);
  font-weight: 700;
}

.extra {
  width: 100%;
  margin-top: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--ink-2, #16171b);
  border: 1rpx solid var(--line-weak, rgba(255, 255, 255, 0.06));
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--text-hi, #f4f4f6);
  caret-color: var(--brand-neon, #d4f826);
}

.extra-ph {
  color: #7a7a83;
}

.go {
  margin-top: 16rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--brand-neon, #d4f826);
  color: var(--brand-neon-ink, #0a0b05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.go:active {
  background: var(--brand-neon-active, #b8dc17);
}

.copy-act {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line, rgba(255, 255, 255, 0.1));
  background: transparent;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hi, #f4f4f6);
}
