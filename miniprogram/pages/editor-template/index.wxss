/* 灵感详情：图先行，文字退后。
   全页只有两段结构——贴边满宽的范例图，和一块相纸上的说明与提示词。 */

.detail {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: transparent;
}

/* ── 范例图 ───────────────────────────────────────────── */

.hero {
  position: relative;
  width: 100%;
}

.hero-swiper {
  width: 100%;
  transition: height 0.2s ease;
}

.hero-item {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: auto;
  display: block;
}

/* 图上的页码：一颗小胶囊，不遮内容 */
.hero-count {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(60, 45, 25, 0.62);
  color: #1c1815;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

/* 多图缩略：贴在图上，不加渐变遮罩 */
.hero-thumbs {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
}

.hero-thumbs-in {
  display: inline-flex;
  gap: 12rpx;
}

.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.thumb.active {
  opacity: 1;
  box-shadow: inset 0 0 0 2rpx #c9761b;
}

/* ── 说明与提示词 ─────────────────────────────────────── */

.body {
  padding: 40rpx var(--gutter) 64rpx;
}

.byline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e4dbcb;
  flex-shrink: 0;
}

.byline-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.byline-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1815;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.byline-meta {
  font-size: 21rpx;
  color: #6f6355;
}

.title {
  display: block;
  margin-top: 28rpx;
  font-size: 44rpx;
  line-height: 1.28;
  font-weight: 800;
  letter-spacing: -1.2rpx;
  color: #fffdf9;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(28, 24, 21, 0.1);
  font-size: 21rpx;
  color: #5c5145;
}

.desc {
  display: block;
  margin-top: 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #5c5145;
}

/* 分组线：一条 1rpx 相纸线，取代又一张卡片 */
.rule {
  height: 1rpx;
  margin: 40rpx 0 32rpx;
  background: rgba(28, 24, 21, 0.08);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1815;
}

.copy {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(28, 24, 21, 0.16);
  font-size: 23rpx;
  font-weight: 600;
  color: #1c1815;
}

.copy:active {
  background: rgba(28, 24, 21, 0.06);
}

.prompt {
  margin-top: 20rpx;
  max-height: 420rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(28, 24, 21, 0.06);
}

.prompt-body {
  display: block;
  font-size: 25rpx;
  line-height: 1.75;
  color: #5c5145;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ── 主操作 ───────────────────────────────────────────── */

.dockbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx var(--gutter) calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(250, 246, 238, 0.94);
  border-top: 1rpx solid rgba(28, 24, 21, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.make {
  width: 100%;
  height: 96rpx;
  border-radius: 9999rpx;
  font-size: 30rpx;
}

.make::after {
  display: none;
}

/* ── 加载骨架 ─────────────────────────────────────────── */

.hero-sk {
  width: 100%;
  height: 560rpx;
  background: var(--skeleton-from, #f3ede2);
  animation: sk-breathe 1.6s ease-in-out infinite;
}

.sk-line {
  height: 28rpx;
  margin: 16rpx var(--gutter) 0;
  border-radius: 8rpx;
  background: var(--skeleton-from, #f3ede2);
  animation: sk-breathe 1.6s ease-in-out infinite;
}

@keyframes sk-breathe {
  0%,
  100% {
    background: var(--skeleton-from, #f3ede2);
  }
  50% {
    background: var(--skeleton-to, #e9e0d2);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-sk,
  .sk-line {
    animation: none;
  }
}
