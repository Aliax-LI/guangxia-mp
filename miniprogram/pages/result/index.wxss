.result-page {
  min-height: 100vh;
  background: #070709;
  display: flex;
  flex-direction: column;
}

/* 影像对比视口 */
.studio-viewport {
  position: relative;
  width: 100%;
  background: #000;
  overflow: hidden;
  touch-action: none;
}

.layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.base {
  z-index: 1;
}

.top {
  z-index: 2;
  overflow: hidden;
  height: 100%;
}

.layer-img {
  width: 100%;
  height: 100%;
  display: block;
}

.top-img {
  max-width: none;
  display: block;
}

/* 角标 */
.corner-tag {
  position: absolute;
  top: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  color: #f4f4f6;
  font-size: 22rpx;
  font-weight: 600;
  z-index: 10;
}

.corner-tag.tag-original {
  right: 24rpx;
}

.corner-tag.tag-ai {
  left: 24rpx;
  background: rgba(10, 11, 5, 0.8);
  border: 1rpx solid rgba(212, 248, 38, 0.45);
  color: var(--brand-neon, #d4f826);
}

/* 荧光滑块手柄 */
.slider-handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 60rpx;
  margin-left: -30rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.handle-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.6);
}

.handle-orb {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 26rpx rgba(212, 248, 38, 0.7), 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  z-index: 2;
}

/* 底部轻提示 */
.hint-pill {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 28rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(12px);
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  z-index: 15;
  pointer-events: none;
}

/* 操作区域 */
.actions-section {
  padding-top: 40rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.result-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 4rpx;
  font-size: 22rpx;
  color: #8a8a93;
}

.note-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 10rpx rgba(212, 248, 38, 0.7);
  flex-shrink: 0;
}

.save-btn {
  width: 100%;
}

.back-btn {
  width: 100%;
}
