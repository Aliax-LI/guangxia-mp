:host {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.empty {
  padding: 18vh 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #111111;
}

.link {
  margin-top: 24rpx;
  padding-bottom: 4rpx;
  border-bottom: 6rpx solid #d4f826;
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.list {
  width: 100%;
  padding: 24rpx 32rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shot {
  width: 420rpx;
  max-width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  background: #f3f3f3;
}

.shots.many .shot {
  width: 280rpx;
  height: 360rpx;
}

.shot.wait {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f3b7c9;
}

.mist {
  position: absolute;
  top: -40%;
  left: -50%;
  width: 220%;
  height: 220%;
  background: linear-gradient(120deg, #6ea2f8 0%, #b7a4f6 20%, #f39dbe 42%, #ffb992 64%, #f8d7a4 82%, #7eb0f8 100%);
}

.mist.on {
  animation: drift 2.6s ease-in-out infinite alternate;
}

.glow {
  position: absolute;
  top: -10%;
  bottom: -10%;
  left: 0;
  width: 46%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
  transform: translateX(-140%);
}

.glow.on {
  animation: wash 2.2s ease-in-out infinite;
}

.wait-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wait-pct {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.96);
  text-shadow: 0 2rpx 16rpx rgba(90, 50, 80, 0.28);
}

.wait-model {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 2rpx 12rpx rgba(90, 50, 80, 0.22);
}

.shot.photo {
  animation: develop-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.ring {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-hole {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #111111;
}

.wait-t {
  position: relative;
  z-index: 1;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #d4f826;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #111111;
}

.ink {
  display: flex;
  align-items: center;
  height: 20rpx;
}

.ink-bar {
  width: 36rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d4f826;
  transform-origin: left center;
  transform: scaleX(0.45);
  opacity: 0.5;
}

.ink-bar.on {
  animation: ink 900ms cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
}

@keyframes drift {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-22%, -12%, 0); }
}

@keyframes wash {
  from { transform: translateX(-140%); }
  to { transform: translateX(280%); }
}

@keyframes develop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ink {
  from { transform: scaleX(0.45); opacity: 0.45; }
  to { transform: scaleX(1); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .mist.on,
  .glow.on,
  .ink-bar.on,
  .shot.photo {
    animation: none;
  }

  .ink-bar {
    transform: none;
    opacity: 1;
  }
}

.actions {
  display: flex;
  gap: 28rpx;
}

.act {
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
  padding-bottom: 2rpx;
  border-bottom: 4rpx solid #d4f826;
}

.rich {
  max-width: 100%;
  box-sizing: border-box;
  overflow-wrap: anywhere;
  word-break: break-word;
  padding: 20rpx 28rpx 24rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: #f4f4f7;
  color: #111111;
}

.card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.hint {
  display: block;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #5c5c61;
}

.choice {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #ececef;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.4;
  color: #111111;
}

.choice.on {
  background: #111111;
  border-color: #111111;
  color: #ffffff;
  font-weight: 600;
}

.extra {
  width: 100%;
  margin-top: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f4f4f7;
  font-size: 28rpx;
  line-height: 1.4;
  color: #111111;
}

.extra-ph {
  color: #5c5c61;
}

.go {
  margin-top: 16rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
