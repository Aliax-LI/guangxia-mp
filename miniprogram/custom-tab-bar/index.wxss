/* 相纸标签条
   白底世界：未选中 = 中灰线稿；选中 = 墨色实心图标 + 墨色粗体标签 + 琥珀短线。
   为什么要实心：白底上「只加粗描边」几乎看不出选中，实心块才有分量。
   自定义组件不继承 page 上的 CSS 变量，这里写实际值。 */
.tb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: #f6f1e7;
  border-top: 1rpx solid rgba(28, 24, 21, 0.06);
}

.tb-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding-top: 8rpx;
}

.tb-item:active {
  opacity: 0.55;
}

/* 图标底盘：默认无底色，选中也不变成琥珀块 */
.tb-mark {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tb-glyph {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

/* 对话：圆角气泡 + 一个尾巴 */
.g-bubble {
  position: absolute;
  top: 4rpx;
  left: 2rpx;
  width: 36rpx;
  height: 28rpx;
  border-radius: 12rpx;
  border: 3rpx solid #6f6355;
  box-sizing: border-box;
}

.g-bubble-tail {
  position: absolute;
  left: 12rpx;
  top: 28rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid #6f6355;
  border-bottom: 3rpx solid #6f6355;
  transform: skewX(-18deg) rotate(-45deg);
  transform-origin: top left;
}

.tb-glyph.on .g-bubble {
  border-color: #1c1815;
  border-width: 3rpx;
  background: #1c1815;
}

.tb-glyph.on .g-bubble-tail {
  border-color: #1c1815;
  background: #1c1815;
}

/* 灵感：四宫格 */
.g-grid {
  position: absolute;
  inset: 2rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.g-cell {
  width: 17rpx;
  height: 17rpx;
  border-radius: 4rpx;
  border: 3rpx solid #6f6355;
  box-sizing: border-box;
}

.tb-glyph.on .g-cell {
  border-color: #1c1815;
  background: #1c1815;
}

/* 我的：头 + 肩 */
.g-head {
  position: absolute;
  top: 2rpx;
  left: 13rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid #6f6355;
  box-sizing: border-box;
}

.g-body {
  position: absolute;
  bottom: 2rpx;
  left: 4rpx;
  width: 32rpx;
  height: 18rpx;
  border: 3rpx solid #6f6355;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  box-sizing: border-box;
}

.tb-glyph.on .g-head,
.tb-glyph.on .g-body {
  border-color: #1c1815;
  background: #1c1815;
}

.tb-label {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: #6f6355;
}

.tb-item.on .tb-label {
  color: #1c1815;
  font-weight: 700;
}

/* 选中短线：坐在安全距离上，不贴屏底 */
.tb-rule {
  width: 32rpx;
  height: 4rpx;
  border-radius: 9999rpx;
  background: transparent;
  margin-top: 2rpx;
}

.tb-rule.on {
  background: #c9761b;
}
