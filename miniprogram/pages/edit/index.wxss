.home {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
  overflow-x: hidden;
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

.stage {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx 24rpx;
  box-sizing: border-box;
}

.hello-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hello {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #111111;
  text-align: center;
}

.seg {
  margin-top: 36rpx;
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f2f2f4;
}

.seg-item {
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #3a3a3c;
}

.seg-item.on {
  background: #ffffff;
  color: #111111;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.recs {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.recs-k {
  margin-bottom: 4rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.idea {
  max-width: 100%;
  padding: 18rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #ececef;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.4;
  color: #111111;
}

.thread {
  flex: 1;
  height: 0;
  width: 100%;
  overflow: hidden;
}

conversation {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.shade {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 4;
}

.dock {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
}

.home .t-chat-sender {
  margin: 8rpx 24rpx 0 !important;
  padding: 8rpx 12rpx 8rpx 8rpx !important;
  border-radius: 999rpx;
  border-color: #ececef;
  box-shadow: none;
}

.home .t-chat-sender__header {
  display: none !important;
  padding: 0 !important;
}

.home .t-chat-sender__actions {
  flex-direction: row !important;
  align-items: center;
  padding: 0 !important;
  gap: 8rpx;
}

.home .t-chat-sender__footer,
.home .t-chat-sender__mode,
.bits {
  display: contents !important;
}

.home .t-chat-sender__textarea {
  order: 1;
  flex: 1;
  min-width: 80rpx;
  min-height: 56rpx !important;
  padding-bottom: 0 !important;
  display: flex;
  align-items: center;
}

.home .t-chat-sender__textarea--control {
  min-height: 40rpx !important;
  padding: 8rpx 0 !important;
  font-size: 28rpx !important;
  line-height: 40rpx !important;
  letter-spacing: 0;
}

.home .t-chat-sender__textarea--placeholder {
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  line-height: 40rpx;
}

.home .t-chat-sender__sendbtn {
  display: none !important;
}

.above {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 4rpx;
}

.cam {
  order: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.side {
  order: 2;
  position: static;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.plus {
  background: #ffffff;
  border: 2rpx solid #e4e4e8;
}

.go {
  background: #111111;
}

.go t-icon,
.go-icon {
  display: flex;
  transform: rotate(-90deg);
}

.t-chat-message {
  max-width: 100%;
  min-width: 0;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.home .t-chat-message .t-chat-message__content {
  min-width: 0 !important;
  max-width: 100%;
  overflow: hidden;
}

.home .t-chat-content,
.home .t-chat-markdown,
.home .t-chat-markdown-p,
.home .t-chat-markdown-h,
.home .t-chat-markdown-h1,
.home .t-chat-markdown-h2,
.home .t-chat-markdown-h3,
.home .t-chat-markdown-list,
.home .t-chat-markdown-list-item {
  max-width: 100% !important;
  box-sizing: border-box;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.home .t-chat-markdown-h1 {
  font-size: 40rpx;
}

.home .t-chat-markdown-h2 {
  font-size: 36rpx;
}

.home .t-chat-markdown-h3 {
  font-size: 32rpx;
}

.home .t-chat-markdown-code,
.home .t-chat-markdown-table {
  max-width: 100%;
  box-sizing: border-box;
}

.home .t-chat-markdown-code__content {
  width: 100% !important;
  max-width: 100%;
  white-space: normal !important;
}

.home .t-chat-markdown-code__text {
  display: block !important;
  white-space: pre-wrap !important;
  word-break: break-all !important;
  overflow-wrap: anywhere !important;
}

.home .t-chat-markdown-table__container {
  max-width: 100% !important;
  white-space: normal !important;
}

.t-chat-message .t-chat-message__content--base {
  padding-top: 0;
}

.t-chat-message.right .t-chat-content,
.t-chat-message.user .t-chat-content,
.t-chat-message--base.right .t-chat-content {
  background: #111111;
  color: #ffffff;
}

.t-chat-message.right .t-chat-content__user,
.t-chat-message.user .t-chat-content__user,
.t-chat-message--base.right .t-chat-content__user {
  color: #ffffff;
}

.t-chat-message--base.assistant .t-chat-content,
.t-chat-message--base.left .t-chat-content {
  background: #f4f4f7;
  padding: 20rpx 28rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  color: #111111;
  line-height: 1.55;
}

.t-chat-message--base.assistant .t-chat-content__assistant,
.t-chat-message--base.left .t-chat-content__assistant {
  color: #111111;
}

.t-chat-message.assistant .t-chat-loading {
  min-height: 72rpx;
  padding: 0 28rpx;
  background: #f4f4f7;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  box-shadow: inset 0 -6rpx 0 #d4f826;
}

.t-chat-loading__moving--left,
.t-chat-loading__moving--right,
.t-chat-loading__moving--top {
  background-color: #111111;
}

.tool {
  position: relative;
}

.chip {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e4e4e8;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e4e4e8;
  background: #fff;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 0 0 0 10rpx;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu {
  position: absolute;
  left: 0;
  bottom: 72rpx;
  min-width: 168rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.menu-item {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #111111;
}

.menu-item.on {
  background: #f3f3f5;
  font-weight: 600;
}

.panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(100% + 8rpx);
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.k {
  display: block;
  margin: 22rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b6b70;
}

.k:first-child {
  margin-top: 0;
}

.model {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f4f4f7;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #111111;
}

.opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ececef;
  background: #fff;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #111111;
}

.opt.on {
  background: #111111;
  border-color: #111111;
  color: #ffffff;
  font-weight: 600;
}
