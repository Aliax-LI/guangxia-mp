/** TDesign 主题覆盖 — 光匣「暗色影像馆」视觉规范 */
page {
  /* 墨色层级：从页面底到浮层 */
  --ink-0: #070709;
  --ink-1: #0e0f12;
  --ink-2: #16171b;
  --ink-3: #1d1e24;
  --ink-4: #26272e;

  /* 文字层级 */
  --text-hi: #f4f4f6;
  --text-mid: #a2a2ab;
  --text-low: #8a8a93;

  /* 描边 */
  --line-weak: rgba(255, 255, 255, 0.06);
  --line: rgba(255, 255, 255, 0.1);
  --line-strong: rgba(255, 255, 255, 0.16);

  /* 品牌荧光绿 */
  --brand-neon: #d4f826;
  --brand-neon-glow: rgba(212, 248, 38, 0.45);
  --brand-neon-soft: rgba(212, 248, 38, 0.12);
  --brand-neon-line: rgba(212, 248, 38, 0.34);
  --brand-neon-active: #b8dc17;
  --brand-neon-ink: #0a0b05;

  --danger: #ff5c57;

  /* TDesign 品牌色 */
  --td-brand-color: #d4f826;
  --td-brand-color-light: rgba(212, 248, 38, 0.12);
  --td-brand-color-focus: #d4f826;
  --td-brand-color-active: #b8dc17;
  --td-brand-color-disabled: #2a2b31;
  --td-brand-color-light-active: rgba(212, 248, 38, 0.18);

  --td-primary-color-7: #d4f826;
  --td-primary-color-1: rgba(212, 248, 38, 0.12);

  /* 背景 */
  --td-bg-color-page: #070709;
  --td-bg-color-container: #0e0f12;
  --td-bg-color-container-hover: #16171b;
  --td-bg-color-container-active: #1d1e24;
  --td-bg-color-secondarycontainer: #16171b;
  --td-bg-color-secondarycontainer-hover: #1d1e24;
  --td-bg-color-component: #16171b;
  --td-bg-color-component-hover: #1d1e24;
  --td-bg-color-component-disabled: #1d1e24;
  --td-bg-color-specialcomponent: #0e0f12;

  /* 字色 */
  --td-text-color-primary: #f4f4f6;
  --td-text-color-secondary: #a2a2ab;
  --td-text-color-placeholder: #7a7a83;
  --td-text-color-disabled: #4e4e57;
  --td-text-color-anti: #0a0b05;
  --td-font-gray-1: #f4f4f6;
  --td-font-gray-2: #a2a2ab;
  --td-font-gray-3: #8a8a93;
  --td-font-white-1: #ffffff;

  /* 描边与组件 */
  --td-border-color: rgba(255, 255, 255, 0.1);
  --td-border-level-1-color: rgba(255, 255, 255, 0.08);
  --td-border-level-2-color: rgba(255, 255, 255, 0.14);
  --td-component-stroke: rgba(255, 255, 255, 0.08);
  --td-component-border: rgba(255, 255, 255, 0.14);

  /* 圆角 */
  --td-radius-small: 12rpx;
  --td-radius-default: 20rpx;
  --td-radius-large: 28rpx;
  --td-radius-extraLarge: 36rpx;
  --td-radius-round: 9999rpx;

  /* 底部 TabBar */
  --td-tab-bar-active-color: #d4f826;
  --td-tab-item-active-color: #d4f826;
  --td-tab-track-color: #d4f826;
  --td-tab-bar-color: #8a8a93;
  --td-tab-bar-bg-color: #0e0f12;

  /* 表单与反馈 */
  --td-input-bg-color: #16171b;
  --td-textarea-background-color: #16171b;
  --td-loading-color: #d4f826;
  --td-loading-text-color: #a2a2ab;
  --td-loading-full-bg-color: rgba(7, 7, 9, 0.72);
  --td-mask-color: rgba(0, 0, 0, 0.72);
  --td-empty-icon-color: #3a3a42;
  --td-empty-description-color: #8a8a93;
  --td-scrollbar-color: rgba(255, 255, 255, 0.16);
}

/* 主操作按钮：荧光绿 */
.btn-ink {
  --td-button-primary-bg-color: #d4f826 !important;
  --td-button-primary-border-color: #d4f826 !important;
  --td-button-primary-active-bg-color: #b8dc17 !important;
  --td-button-primary-active-border-color: #b8dc17 !important;
  --td-button-primary-color: #0a0b05 !important;
  border-radius: 9999rpx !important;
  font-weight: 700 !important;
}

.btn-accent-fill {
  --td-button-primary-bg-color: #d4f826 !important;
  --td-button-primary-border-color: #d4f826 !important;
  --td-button-primary-color: #0a0b05 !important;
  --td-button-primary-active-bg-color: #b8dc17 !important;
  border-radius: 9999rpx !important;
  font-weight: 700 !important;
}

.btn-pill-outline {
  border-radius: 9999rpx !important;
  font-weight: 600 !important;
  border-color: rgba(255, 255, 255, 0.16) !important;
  color: #f4f4f6 !important;
  background: transparent !important;
}
