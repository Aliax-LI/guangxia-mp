.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 28rpx calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  box-sizing: border-box;
}

.tab-bar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 10rpx;
  border-radius: 9999rpx;
  background: rgba(14, 15, 18, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: opacity 0.15s ease;
}

.tab-item:active {
  opacity: 0.72;
}

.tab-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.tab-item.active .tab-icon-box {
  background: #d4f826;
  box-shadow: 0 0 22rpx rgba(212, 248, 38, 0.35);
}

.tab-label {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  color: #8a8a93;
  transition: color 0.2s ease;
}

.tab-item.active .tab-label {
  color: #f4f4f6;
  font-weight: 700;
}
