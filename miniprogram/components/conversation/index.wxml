<!--
  Primary: 助手回复 / 生成结果
  Secondary: 用户图文（同组右对齐）
  Tertiary: 重试、存作品集
-->
<scroll-view
  wx:if="{{rows.length}}"
  class="thread-scroll"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  scroll-into-view="{{scrollIntoView}}"
  scroll-with-animation
  enable-back-to-top
  bindscroll="onThreadScroll"
  bindtouchstart="onThreadTouch"
>
  <view class="list">
    <view wx:for="{{rows}}" wx:key="id" id="turn-{{item.id}}" class="turn">
      <view wx:if="{{item.inputImages.length || item.prompt}}" class="turn-user">
        <view
          wx:if="{{item.inputImages && item.inputImages.length}}"
          class="user-media {{item.inputImages.length > 1 ? 'many' : ''}}"
        >
          <image
            wx:for="{{item.inputImages}}"
            wx:for-item="src"
            wx:for-index="imgIndex"
            wx:key="imgIndex"
            class="user-img"
            src="{{src}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            data-src="{{src}}"
            bindtap="onPreviewInput"
            show-menu-by-longpress="{{true}}"
          />
        </view>
        <view wx:if="{{item.prompt}}" class="user-bubble">
          <text class="user-text" selectable="{{true}}" user-select="{{true}}">{{item.prompt}}</text>
        </view>
      </view>

      <block wx:if="{{item.status === 'error'}}">
        <view class="turn-assist err">
          <view class="err-mark">
            <t-icon name="error-circle" size="32rpx" color="#c0392b" />
            <text class="err-msg">{{item.errorLabel}}</text>
          </view>
          <view class="err-retry" data-id="{{item.id}}" bindtap="onRetry">重试一次</view>
        </view>
      </block>

      <block
        wx:if="{{item.status !== 'error' && (item.thinking || item.generating || item.showImages || item.segments.length || item.liveText || item.assistantContent.length || item.status === 'generating')}}"
      >
        <t-chat-message
          role="assistant"
          placement="left"
          variant="base"
          status="{{item.assistantStatus}}"
          content="{{item.assistantContent}}"
          animation="dots"
          data-id="{{item.id}}"
          bindlongpress="onCopyReply"
        >
        <view wx:if="{{item.thinking}}" slot="content" class="think">
          <view class="think-dots" aria-hidden="true">
            <view class="think-dot d0 {{motion ? 'on' : ''}}"></view>
            <view class="think-dot d1 {{motion ? 'on' : ''}}"></view>
            <view class="think-dot d2 {{motion ? 'on' : ''}}"></view>
          </view>
          <text class="think-label">正在思考</text>
        </view>
        <view wx:elif="{{item.segments.length}}" slot="content" class="rich">
          <block wx:for="{{item.segments}}" wx:for-item="seg" wx:for-index="si" wx:key="si">
            <t-chat-markdown wx:if="{{seg.kind === 'md'}}" content="{{seg.text}}" />
            <view
              wx:elif="{{seg.kind === 'copy'}}"
              class="copy-act"
              data-id="{{item.id}}"
              data-si="{{si}}"
              bindtap="onCopyGenUi"
            >{{seg.label}}</view>
            <view wx:elif="{{seg.kind === 'choices'}}" class="card">
              <text wx:if="{{seg.card.hint}}" class="hint">{{seg.card.hint}}</text>
              <view
                wx:for="{{seg.card.options}}"
                wx:for-item="opt"
                wx:key="value"
                class="choice {{item.pick === opt.value ? 'on' : ''}}"
                data-id="{{item.id}}"
                data-value="{{opt.value}}"
                bindtap="onPickChoice"
              >{{opt.label}}</view>
              <textarea
                wx:if="{{seg.card.placeholder}}"
                class="extra"
                placeholder="{{seg.card.placeholder}}"
                placeholder-class="extra-ph"
                data-id="{{item.id}}"
                value="{{item.detail}}"
                bindinput="onDetail"
                auto-height
                maxlength="200"
              />
              <view class="go" data-id="{{item.id}}" bindtap="onStartChoice">{{seg.card.button}}</view>
            </view>
          </block>
        </view>
        <view wx:elif="{{item.generating || item.showImages}}" slot="content" class="generation-content">
        <view wx:if="{{item.generating}}" class="generation-status"><view class="status-dot"></view><text class="generation-label">{{item.stage}}</text></view>
        <view wx:if="{{item.generating}}" class="wait-surface" style="--wait-padding: {{item.waitPadding}}%;">
          <view class="wait-glow {{motion ? 'on' : ''}}" aria-hidden="true"></view>
          <view class="wait-dots {{motion ? 'on' : ''}}" aria-hidden="true"></view>
          <view class="wait-dot-wave {{motion ? 'on' : ''}}" aria-hidden="true"></view>
          <view class="wait-center">
            <text class="wait-time-label">已等待</text>
            <text class="wait-elapsed">{{item.elapsed || '00:00'}}</text>
            <text class="wait-stage">{{item.loadingMessage || '正在准备画布'}}</text>
            <view class="wait-activity" aria-hidden="true">
              <view class="activity-dot a0 {{motion ? 'on' : ''}}"></view>
              <view class="activity-dot a1 {{motion ? 'on' : ''}}"></view>
              <view class="activity-dot a2 {{motion ? 'on' : ''}}"></view>
            </view>
          </view>
          <text wx:if="{{item.places.length > 1}}" class="wait-batch">{{item.places.length}} 张</text>
        </view>
        <view wx:else class="shots {{item.images.length > 1 ? 'many' : ''}}">
            <image
              wx:for="{{item.images}}"
              wx:for-item="src"
              wx:for-index="imgIndex"
              wx:key="imgIndex"
              class="shot photo"
              src="{{src}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              data-src="{{src}}"
              bindtap="onPreview"
              bindload="onMediaLoad"
              show-menu-by-longpress="{{true}}"
            />
        </view>
        </view>
        <view wx:if="{{item.liveText}}" slot="actionbar" class="ink">
          <view class="ink-bar {{motion ? 'on' : ''}}"></view>
        </view>
        <view wx:if="{{item.kind === 'text' && item.status === 'done' && (item.assistantContent.length || item.segments.length)}}" slot="actionbar" class="actions">
          <view class="chip-act" data-id="{{item.id}}" bindtap="onCopyReply" aria-role="button" aria-label="复制回复">复制回复</view>
        </view>
        <!-- 成片后的动作：轻量文字按钮。实心琥珀只留给页面级主操作（如「做同款」），
             消息流里的动作不与它抢层级，也不遮在图片上。 -->
        <view wx:if="{{item.showImages}}" slot="actionbar" class="actions">
          <text wx:if="{{item.duration}}" class="generation-duration">耗时 {{item.duration}}</text>
          <view class="chip-act" data-id="{{item.id}}" bindtap="onEditImage" aria-role="button" aria-label="继续修改这张图">继续修改</view>
          <view wx:if="{{item.copyImageUrl}}" class="chip-act" data-id="{{item.id}}" bindtap="onCopyImageLink" aria-role="button">复制图片链接</view>
          <view
            class="chip-act {{item.saved ? 'done' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSave"
            aria-role="button"
            aria-label="存入作品集"
          >
            <t-icon
              name="{{item.saved ? 'check-circle-filled' : 'bookmark'}}"
              size="26rpx"
              color="{{item.saved ? '#C9761B' : '#5C5145'}}"
            />
            <text>{{item.saved ? '已存作品集' : '存作品集'}}</text>
          </view>
        </view>
        </t-chat-message>
      </block>
    </view>
  </view>
  <view id="thread-end" style="height: 1px;"></view>
</scroll-view>

<view wx:if="{{rows.length && !following}}" class="latest" bindtap="scrollToBottom" aria-role="button">回到最新消息 ↓</view>

<view wx:if="{{!rows.length}}" class="empty">
  <view class="empty-mark">
    <t-icon name="chat-bubble-smile" size="52rpx" color="#c9761b" />
  </view>
  <text class="empty-title">直接说，或先做一张图</text>
  <text class="empty-sub">对话用来改文案、找灵感；画图会记住你这次上传的参考图</text>
  <view class="empty-act" bindtap="onCreate">
    <text>开始画图</text>
    <t-icon name="chevron-right" size="28rpx" color="#fffdf9" />
  </view>
</view>
