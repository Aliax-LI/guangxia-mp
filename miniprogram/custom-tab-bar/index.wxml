<view class="tab-shell">
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:key="value"
      class="tab-item {{value === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTap"
    >
      <view class="tab-icon-box">
        <t-icon
          name="{{item.icon}}"
          size="36rpx"
          color="{{value === item.value ? '#0A0B05' : '#8A8A93'}}"
        />
      </view>
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>
</view>
