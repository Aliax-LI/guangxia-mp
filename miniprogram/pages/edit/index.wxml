<view class="home {{keyboard ? 'kb-open' : ''}}" style="height: {{viewportHeight - keyboard}}px;">
  <!-- 顶栏：会话历史 / 当前会话 / 新建同类型会话 -->
  <view class="nav">
    <view class="icon-btn" catchtap="onToggleHistory" aria-role="button" aria-label="会话历史">
      <t-icon name="view-list" size="38rpx" color="#1c1815" />
    </view>
    <view class="nav-mid">
      <text class="nav-title">{{sessionTitle}}</text>
      <text class="nav-kind">{{tool === 'image' ? '画图' : '对话'}}</text>
    </view>
    <view class="icon-btn" catchtap="onNewSameKind" aria-role="button" aria-label="新建会话">
      <t-icon name="chat-add" size="38rpx" color="#1c1815" />
    </view>
  </view>

  <!-- 空态：一句话说明能力 + 可直接点的起始句（一段文字，不是一摞卡片） -->
  <view wx:if="{{!turnCount}}" class="intro">
    <text class="intro-title">{{tool === 'image' ? '说画面，我来出图' : '今天想聊点什么？'}}</text>
    <text class="intro-sub">{{tool === 'image' ? '上传参考图，或用一句话描述；出图后可以继续修改' : '可以发文字，也可以带图一起问'}}</text>

    <view wx:if="{{!keyboard}}" class="starters">
      <text class="starters-label">{{tool === 'image' ? '试试这些画面' : '试试这样问'}}</text>
      <view
        wx:for="{{tool === 'image' ? imageIdeas : chatIdeas}}"
        wx:key="*this"
        class="starter"
        data-text="{{item}}"
        bindtap="onIdea"
      >
        <view class="starter-mark"></view>
        <text class="starter-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="thread">
    <conversation
      id="chat-conversation"
      bind:create="onOpenImage"
      bind:retry="onRetry"
      bind:preview="onPreview"
      bind:save="onSave"
      bind:choose="onChoose"
      bind:editimage="onEditImage"
    />
  </view>

  <view wx:if="{{menuOpen || panelOpen || historyOpen}}" class="scrim" catchtap="onClosePop" catchtouchmove="noop"></view>

  <!-- 会话抽屉 -->
  <view class="drawer {{historyOpen ? 'open' : ''}}" catchtap="noop">
    <view class="drawer-hd">
      <text class="drawer-title">会话</text>
      <view class="icon-btn icon-btn--sm" catchtap="onCloseHistory" aria-role="button" aria-label="关闭">
        <t-icon name="close" size="36rpx" color="#5c5145" />
      </view>
    </view>

    <view class="drawer-acts">
      <view class="drawer-new" data-kind="chat" catchtap="onNewSessionTap">
        <t-icon name="chat" size="32rpx" color="#c9761b" />
        <text>新对话</text>
      </view>
      <view class="drawer-new" data-kind="image" catchtap="onNewSessionTap">
        <t-icon name="image" size="32rpx" color="#c9761b" />
        <text>新画图</text>
      </view>
    </view>

    <view
      class="drawer-clear {{turnCount ? '' : 'off'}}"
      catchtap="onClearCurrentSession"
      aria-role="button"
      aria-label="清空当前会话消息"
    >
      <t-icon name="clear" size="30rpx" color="{{turnCount ? '#5c5145' : '#544A3F'}}" />
      <text>清空当前会话</text>
    </view>

    <scroll-view class="drawer-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="drawer-list-in">
        <block wx:if="{{sessionRows.length}}">
          <view
            wx:for="{{sessionRows}}"
            wx:key="id"
            class="sess {{item.active ? 'on' : ''}}"
            data-id="{{item.id}}"
            catchtap="onPickSession"
          >
            <view class="sess-main">
              <text class="sess-title">{{item.title}}</text>
              <view class="sess-meta">
                <text class="sess-kind">{{item.kindLabel}}</text>
                <text class="sess-dot">·</text>
                <text class="sess-time">{{item.timeLabel}}</text>
              </view>
            </view>
            <view
              class="sess-del"
              data-id="{{item.id}}"
              catchtap="onDeleteSession"
              aria-role="button"
              aria-label="删除会话"
            >
              <t-icon name="delete" size="32rpx" color="#8b7f70" />
            </view>
          </view>
        </block>
        <view wx:else class="drawer-empty">
          <text>还没有记录</text>
          <text class="drawer-empty-sub">发一条消息就会出现在这里</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 输入坞：参数条 / 参数面板 / 输入框 -->
  <view class="dock">
    <view class="dock-bar">
      <view class="tool">
        <view class="chip" catchtap="onToggleMenu">
          <text>{{tool === 'image' ? '画图' : '对话'}}</text>
          <t-icon name="{{menuOpen ? 'chevron-up' : 'chevron-down'}}" size="24rpx" color="#6f6355" />
        </view>
        <view wx:if="{{menuOpen}}" class="menu" catchtap="noop">
          <view class="menu-item {{tool === 'chat' ? 'on' : ''}}" data-tool="chat" catchtap="onPickTool">
            <t-icon name="chat" size="32rpx" color="{{tool === 'chat' ? '#c9761b' : '#5c5145'}}" />
            <text>对话</text>
          </view>
          <view class="menu-item {{tool === 'image' ? 'on' : ''}}" data-tool="image" catchtap="onPickTool">
            <t-icon name="image" size="32rpx" color="{{tool === 'image' ? '#c9761b' : '#5c5145'}}" />
            <text>画图</text>
          </view>
        </view>
      </view>

      <view wx:if="{{tool === 'image'}}" class="chip" catchtap="onTogglePanel">
        <text>{{ratioLabel}}</text>
        <text class="chip-sep">·</text>
        <text>{{count}} 张</text>
        <t-icon name="{{panelOpen ? 'chevron-up' : 'chevron-down'}}" size="24rpx" color="#6f6355" />
      </view>

      <view class="dock-spacer"></view>

      <text wx:if="{{nearLimit}}" class="count {{overLimit ? 'over' : ''}}">{{draft.length}} / 4000</text>

      <view
        wx:if="{{keyboard}}"
        class="kb-hide"
        catchtap="onHideKeyboard"
        aria-role="button"
        aria-label="收起键盘"
      >
        <t-icon name="chevron-down" size="26rpx" color="#6f6355" />
      </view>


    </view>

      <scroll-view wx:if="{{refImages.length}}" class="ref-strip" scroll-x><view class="ref-strip-in">
        <view wx:for="{{refImages}}" wx:key="*this" class="ref">
          <image class="ref-img" src="{{item}}" mode="aspectFill" />
          <view class="ref-x" data-index="{{index}}" catchtap="onRemoveRef" aria-role="button" aria-label="移除参考图">
            <t-icon name="close" size="18rpx" color="#1c1815" />
          </view>
        </view>
      </view></scroll-view>
    <view class="composer">
      <view class="composer-in">
        <view class="composer-cam" catchtap="onCamera" aria-role="button" aria-label="拍照或从相册选择">
          <t-icon name="camera" size="38rpx" color="#5c5145" />
        </view>
        <textarea
          id="composer-textarea"
          class="composer-input composer-textarea"
          style="height: {{inputLines * 44 + 32}}rpx;"
          value="{{draft}}"
          focus="{{inputFocus}}"
          hidden="{{panelOpen || historyOpen || menuOpen}}"
          placeholder="{{tool === 'image' ? (refImages.length ? '想修改这张图的哪里？' : '描述想生成的画面') : '发消息，可带图提问'}}"
          placeholder-class="composer-placeholder"
          disable-default-padding="{{true}}"
          maxlength="4000"
          confirm-type="send"
          confirm-hold="{{true}}"
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
          cursor-spacing="16"
          bindinput="onDraft"
          bindlinechange="onInputLineChange"
          bindconfirm="onSend"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindkeyboardheightchange="onKeyboard"
        />
        <view class="composer-actions">
          <view
            class="composer-end plus"
            catchtap="onAlbum"
            aria-role="button"
            aria-label="添加图片"
          >
            <t-icon name="add" size="38rpx" color="#5c5145" />
          </view>
          <view
            wx:if="{{canSend}}"
            class="composer-end go {{busy ? 'busy' : ''}}" aria-disabled="{{busy}}"
            catchtap="onSendTap"
            aria-role="button"
            aria-label="发送"
          >
            <!-- 发送用「向上箭头」：CSS 绘制（WXML 不支持内联 SVG，会被渲染器吃掉） -->
            <view class="send-arrow" aria-hidden="true"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{panelOpen}}" class="panel" catchtap="noop" aria-role="dialog" aria-label="画图设置">
    <view class="panel-heading">
      <text class="panel-title">画图设置</text>
      <view class="panel-close" catchtap="onClosePop" aria-role="button" aria-label="关闭设置"><t-icon name="close" size="36rpx" /></view>
    </view>
    <scroll-view class="panel-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="p-row model-picker" catchtap="onToggleModels" aria-role="button" aria-label="选择模型" aria-expanded="{{modelOpen}}">
        <text class="p-k">模型</text><view class="model-value"><text>{{imageModel}}</text><t-icon name="{{modelOpen ? 'chevron-up' : 'chevron-down'}}" size="26rpx" /></view>
      </view>
      <view wx:if="{{modelOpen}}" class="model-options">
        <view wx:for="{{imageModelLabels}}" wx:key="*this" class="model-option {{imageModelIndex === index ? 'selected' : ''}}" data-index="{{index}}" catchtap="onPickModel" aria-role="button" aria-pressed="{{imageModelIndex === index}}">
          <text>{{item}}</text><t-icon wx:if="{{imageModelIndex === index}}" name="check" size="30rpx" color="#a85f11" />
        </view>
      </view>
      <text class="p-k p-k--block">画幅</text>
      <view class="pills ratio-options">
        <view wx:for="{{ratios}}" wx:key="id" class="pill ratio-tile {{ratioId === item.id ? 'pill--on' : ''}}" data-id="{{item.id}}" data-group="ratio" catchtap="onPickOpt" aria-role="button" aria-label="{{item.label}}" aria-pressed="{{ratioId === item.id}}">
          <view class="ratio-preview"><view class="ratio-shape {{item.id === 'auto' ? 'ratio-auto' : item.id === '1:1' ? 'ratio-square' : item.id === '2:3' ? 'ratio-portrait' : 'ratio-landscape'}}"></view></view>
          <text class="ratio-name">{{item.id === 'auto' ? '自动' : item.id === '1:1' ? '方形' : item.id === '2:3' ? '竖版' : '横版'}}</text>
          <text wx:if="{{item.id !== 'auto'}}" class="ratio-size">{{item.id}}</text>
        </view>
      </view>
      <text class="p-k p-k--block">生成张数</text>
      <view class="pills count-options">
        <view wx:for="{{counts}}" wx:key="*this" class="pill {{count === item ? 'pill--on' : ''}}" data-id="{{item}}" data-group="count" catchtap="onPickOpt" aria-role="button" aria-pressed="{{count === item}}">{{item}} 张</view>
      </view>
      <view class="advanced-toggle" catchtap="onToggleAdvanced" aria-role="button" aria-expanded="{{advancedOpen}}"><text>更多设置</text><t-icon name="{{advancedOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" /></view>
      <view wx:if="{{advancedOpen}}">
        <text class="p-k p-k--block">画面质量</text>
        <view class="pills quality-options">
          <view wx:for="{{qualities}}" wx:key="id" class="pill {{quality === item.id ? 'pill--on' : ''}}" data-id="{{item.id}}" data-group="quality" catchtap="onPickOpt" aria-role="button" aria-pressed="{{quality === item.id}}">{{item.id === 'auto' ? '自动' : item.label}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="panel-footer"><view class="panel-reset" catchtap="onResetOptions" aria-role="button">恢复默认</view><view class="panel-done" catchtap="onClosePop" aria-role="button">完成</view></view>
  </view>

  <view wx:if="{{showPrivacyPanel}}" class="privacy-mask" catchtouchmove="true">
    <view class="privacy-card">
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-desc">{{privacyDesc}}</text>
      <text class="privacy-link" bindtap="onOpenPrivacyContract">查看隐私保护指引</text>
      <view class="privacy-actions">
        <button
          id="edit-agree-btn"
          class="privacy-agree-btn"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onPrivacyAgree"
        >
          同意并继续
        </button>
      </view>
    </view>
  </view>
</view>
