<!-- 相纸标签条：三层视觉 = 图标块（选中）/ 标签 / 琥珀短线（选中）。
     无图标资源依赖，t-icon 在自定义 TabBar 里会因 lazyCodeLoading 丢字形，这里改用内联 SVG。 -->
<view class="tb">
  <view
    wx:for="{{list}}"
    wx:key="value"
    class="tb-item {{value === item.value ? 'on' : ''}}"
    data-value="{{item.value}}"
    catchtap="onTap"
    aria-role="tab"
    aria-selected="{{value === item.value}}"
  >
    <view class="tb-mark">
      <view wx:if="{{item.icon === 'chat-bubble'}}" class="tb-glyph {{value === item.value ? 'on' : ''}}">
        <view class="g-bubble"></view>
        <view class="g-bubble-tail"></view>
      </view>
      <view wx:elif="{{item.icon === 'app'}}" class="tb-glyph {{value === item.value ? 'on' : ''}}">
        <view class="g-grid">
          <view class="g-cell"></view>
          <view class="g-cell"></view>
          <view class="g-cell"></view>
          <view class="g-cell"></view>
        </view>
      </view>
      <view wx:else class="tb-glyph {{value === item.value ? 'on' : ''}}">
        <view class="g-head"></view>
        <view class="g-body"></view>
      </view>
    </view>
    <text class="tb-label">{{item.label}}</text>
    <view class="tb-rule {{value === item.value ? 'on' : ''}}"></view>
  </view>
</view>
