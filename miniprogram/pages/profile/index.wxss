.profile-page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  min-height: 100vh;
  background: #070709;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 用户头部信息区 */
.user-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx 0;
}

.user-header-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.header-help-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #141519;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.header-help-btn:active {
  background: #1d1e24;
}

.avatar-shell {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #141519;
  box-shadow:
    0 0 0 3rpx rgba(212, 248, 38, 0.85),
    0 0 32rpx rgba(212, 248, 38, 0.18);
}

.user-avatar {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 140rpx !important;
  height: 140rpx !important;
  min-width: 140rpx !important;
  min-height: 140rpx !important;
  max-width: 140rpx !important;
  max-height: 140rpx !important;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
}

.avatar-hit::after {
  display: none;
  border: none;
}

.user-name-input {
  display: block;
  width: 100%;
  max-width: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  font-size: 40rpx;
  font-weight: 800;
  color: #f4f4f6;
  caret-color: var(--brand-neon, #d4f826);
  height: 56rpx;
  line-height: 56rpx;
  box-sizing: border-box;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: block;
  width: 100%;
}

.user-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #f4f4f6;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.id-text {
  font-size: 24rpx;
  color: #8a8a93;
}

.copy-icon {
  margin-left: 4rpx;
}

/* 账户概览卡片 */
.account-card {
  position: relative;
  margin: 30rpx 28rpx 0;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(150deg, #15160f 0%, #0e0f12 54%);
  border: 1rpx solid rgba(212, 248, 38, 0.16);
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.4);
}

.account-card::after {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 248, 38, 0.14) 0%, rgba(212, 248, 38, 0.03) 45%, transparent 70%);
  pointer-events: none;
}

.account-head {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.account-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.account-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 10rpx rgba(212, 248, 38, 0.7);
}

.account-kicker {
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #8a8a93;
}

.account-tag {
  font-size: 20rpx;
  line-height: 1;
  color: var(--brand-neon, #d4f826);
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(212, 248, 38, 0.08);
  border: 1rpx solid rgba(212, 248, 38, 0.2);
}

.stats-group {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-item {
  min-width: 0;
}

.stat-num {
  display: block;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #f4f4f6;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.stat-item:first-child .stat-num {
  color: var(--brand-neon, #d4f826);
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: #8a8a93;
}

.profile-actions {
  position: relative;
  margin-top: 28rpx;
}

.edit-btn {
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #f4f4f6;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.09);
}

/* 签名行 */
.bio-row {
  padding: 24rpx 32rpx 0;
}

.bio-text {
  font-size: 26rpx;
  color: #8a8a93;
  line-height: 1.45;
}

/* 快捷功能双卡片 */
.feature-dual-cards {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}

.feature-card {
  flex: 1;
  background: #0e0f12;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: transform 0.15s ease;
}

.feature-card:active {
  transform: scale(0.98);
  background: #141519;
}

.feat-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(212, 248, 38, 0.1);
  border: 1rpx solid rgba(212, 248, 38, 0.2);
}

.feat-text-box {
  flex: 1;
  min-width: 0;
}

.feat-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.feat-sub {
  display: block;
  font-size: 20rpx;
  color: #8a8a93;
  margin-top: 4rpx;
}

/* 作品分类 Tab 栏 */
.works-tab-bar {
  display: flex;
  align-items: center;
  gap: 44rpx;
  padding: 36rpx 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.works-tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding-bottom: 20rpx;
}

.tab-title-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tab-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #8a8a93;
  transition: all 0.15s ease;
}

.works-tab-item.active .tab-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.tab-line {
  position: absolute;
  bottom: -1rpx;
  width: 44rpx;
  height: 6rpx;
  border-radius: 9999rpx;
  background: var(--brand-neon, #d4f826);
  box-shadow: 0 0 12rpx rgba(212, 248, 38, 0.5);
}

/* 九宫格方形作品集展示 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  padding-top: 6rpx;
  background: #070709;
}

.work-grid-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: #141519;
  overflow: hidden;
}

.work-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 草稿箱蒙层 */
.draft-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #ffffff;
}

.draft-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.expand-icon-box {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-tab-box {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

/* 荧光绿悬浮加号 */
.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--brand-neon, #d4f826);
  border: 4rpx solid rgba(7, 7, 9, 0.9);
  box-shadow: 0 10rpx 32rpx rgba(212, 248, 38, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  transition: transform 0.15s ease;
}

.fab-btn:active {
  transform: scale(0.92);
}
