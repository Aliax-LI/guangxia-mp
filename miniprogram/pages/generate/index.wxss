.generate-page {
  width: 100%;
  height: 100vh;
  background: #000000;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 提示词编辑界面 */
.prompt-editor {
  flex: 1;
  overflow-y: auto;
  background: #111111;
}

.editor-container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.editor-preview {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 40rpx;
}

.preview-thumb {
  width: 100%;
  height: 100%;
}

.preview-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* API 选择器 */
.api-selector {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.api-options {
  display: flex;
  gap: 24rpx;
}

.api-option {
  flex: 1;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.api-option.active {
  background: rgba(212, 248, 38, 0.1);
  border-color: #D4F826;
}

.option-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.option-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  display: block;
}

.option-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #D4F826;
}

/* 提示词输入 */
.prompt-input-section {
  margin-bottom: 40rpx;
}

.prompt-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
  box-sizing: border-box;
}

.prompt-textarea::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.char-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: right;
}

/* 底部按钮 */
.editor-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.btn-cancel {
  flex: 1;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 80rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-generate {
  flex: 2;
  height: 96rpx;
  background: linear-gradient(135deg, #D4F826 0%, #C5E820 100%);
  border-radius: 80rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 40rpx rgba(212, 248, 38, 0.4);
}

.btn-generate::after {
  border: none;
}

.btn-cancel::after {
  border: none;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(20px);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.navbar-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.navbar-right {
  width: 140rpx;
  text-align: right;
}

.navbar-action {
  font-size: 28rpx;
  color: #FFFFFF;
}

/* 预览区域 */
.preview-area {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.bg-blur {
  position: absolute;
  top: -10%;
  left: -10%;
  width: 120%;
  height: 120%;
  filter: blur(80rpx);
  opacity: 0.3;
}

.main-preview {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.preview-image {
  max-width: 90%;
  max-height: 85%;
  border-radius: 20rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.5);
  animation: scaleIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes scaleIn {
  0% {
    opacity: 0;
    transform: scale(0.9);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.preview-image.placeholder {
  opacity: 0.5;
  filter: blur(8rpx) brightness(0.7);
}

/* 生成进度遮罩 */
.progress-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(40rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.progress-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  width: 100%;
}

/* 醒图风格圆形进度 */
.progress-ring {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 60rpx;
  animation: none;
}

.ring-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.ring-bg {
  fill: none;
  stroke: rgba(255, 255, 255, 0.05);
  stroke-width: 8;
}

.ring-progress {
  fill: none;
  stroke: #D4F826;
  stroke-width: 8;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  filter: drop-shadow(0 0 16rpx rgba(212, 248, 38, 0.6));
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 80rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -2rpx;
  text-shadow: 0 0 20rpx rgba(255, 255, 255, 0.3);
}

.progress-label {
  font-size: 36rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.progress-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 80rpx;
  font-weight: 400;
}

.cancel-btn {
  padding: 24rpx 88rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 80rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.cancel-btn:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.95);
}

.cancel-btn text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 完成状态 */
.complete-overlay {
  position: absolute;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  0% {
    opacity: 0;
    transform: translate(-50%, -40rpx);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.complete-badge {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 48rpx;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(30rpx);
  border-radius: 80rpx;
  border: 2rpx solid rgba(212, 248, 38, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
}

.complete-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* 底部工具栏 */
.bottom-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.tool-left,
.tool-right {
  flex: 1;
}

.tool-center {
  flex: 2;
  display: flex;
  justify-content: center;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: all 0.2s ease;
}

.tool-btn:active {
  opacity: 0.6;
  transform: scale(0.95);
}

.tool-btn text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx 72rpx;
  background: linear-gradient(135deg, #D4F826 0%, #C5E820 100%);
  border-radius: 80rpx;
  box-shadow: 0 12rpx 40rpx rgba(212, 248, 38, 0.5),
              0 4rpx 16rpx rgba(212, 248, 38, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.primary-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 32rpx rgba(212, 248, 38, 0.4),
              0 2rpx 12rpx rgba(212, 248, 38, 0.2);
}

.primary-btn text {
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
  letter-spacing: 0.5rpx;
}

/* 色彩调节器 */
.color-adjuster {
  position: fixed;
  bottom: 220rpx;
  left: 32rpx;
  right: 32rpx;
  padding: 40rpx 36rpx;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(30rpx);
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
  z-index: 90;
  animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  0% {
    opacity: 0;
    transform: translateY(40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.adjuster-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.adjuster-title {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
}

.adjuster-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #D4F826;
  text-shadow: 0 0 20rpx rgba(212, 248, 38, 0.5);
  letter-spacing: -1rpx;
}

.adjuster-slider {
  width: 100%;
}
