.tpl-editor {
  padding-top: 20rpx;
  padding-bottom: 240rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading-wrap {
  padding: 200rpx 0;
  display: flex;
  justify-content: center;
}

/* 多图范例区 */
.gallery-wrap {
  position: relative;
  background: #000;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.5);
}

.gallery-swiper {
  width: 100%;
  transition: height 0.2s ease;
}

.gallery-item {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
}

.gallery-img {
  width: 100%;
  height: auto;
  display: block;
  vertical-align: top;
}

.hero-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 2;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
  color: #f4f4f6;
  font-size: 20rpx;
  font-weight: 500;
}

.thumb-scroll {
  width: 100%;
  padding: 16rpx 20rpx 20rpx;
  box-sizing: border-box;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

.thumb-inner {
  display: inline-flex;
  gap: 12rpx;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  opacity: 0.55;
  flex-shrink: 0;
}

.thumb.active {
  border-color: #d4f826;
  opacity: 1;
}

/* 模版说明卡片 */
.meta-card {
  padding: 32rpx;
  background: #0e0f12;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.35);
}

.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1d1e24;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

.author-text {
  flex: 1;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.author-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a93;
}

.like-pill {
  font-size: 22rpx;
  color: #8a8a93;
  flex-shrink: 0;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #f4f4f6;
  line-height: 1.4;
  letter-spacing: -0.3rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag-chip {
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  background: #1d1e24;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: #b9b9c1;
}

.prompt-card {
  padding: 28rpx 32rpx 32rpx;
  background: #0e0f12;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.35);
}

.prompt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.copy-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
  font-weight: 600;
  color: #f4f4f6;
  flex-shrink: 0;
}

.copy-pill:active {
  background: rgba(255, 255, 255, 0.1);
}

.prompt-label {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a8a93;
}

.prompt-scroll {
  margin-top: 20rpx;
  max-height: 320rpx;
  padding: 18rpx;
  background: #16171b;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.prompt-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #b9b9c1;
  white-space: pre-wrap;
}

.desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8a93;
  line-height: 1.55;
}

.rule-tip {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  background: #16171b;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #8a8a93;
}

.rule-tip.must {
  background: rgba(212, 248, 38, 0.08);
  border-color: rgba(212, 248, 38, 0.24);
  color: #d8ec8a;
}

/* 照片上传区域 */
.upload-section {
  margin-top: 40rpx;
}

.section-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f4f4f6;
}

.section-subtitle {
  font-size: 22rpx;
  font-weight: 600;
  color: #8a8a93;
}

.section-subtitle.is-must {
  color: #d4f826;
}

.upload-box {
  height: 320rpx;
  background: #0e0f12;
  border: 3rpx dashed rgba(255, 255, 255, 0.14);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.upload-box:active {
  background: #141519;
  border-color: rgba(212, 248, 38, 0.4);
}

.upload-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: var(--brand-neon, #d4f826);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 28rpx rgba(212, 248, 38, 0.28);
  margin-bottom: 20rpx;
}

.upload-main-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #f4f4f6;
}

.upload-sub-text {
  font-size: 22rpx;
  color: #8a8a93;
  margin-top: 8rpx;
}

.preview-box {
  position: relative;
  height: 380rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  background: #000;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.4);
}

.user-img {
  width: 100%;
  height: 100%;
  display: block;
}

.preview-overlay {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.change-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12px);
  padding: 10rpx 24rpx;
  border-radius: 9999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

/* 底部操作条 */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(7, 7, 9, 0.92);
  backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  z-index: 100;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
}

.lime-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #d4f826;
}
