.pe-page {
  min-height: 100vh;
  padding: var(--s5) var(--gutter) calc(var(--s6) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--s4);
}

.pe-avatar-sec {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: var(--s2) 0;
}

.pe-avatar-wrap {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--ink-2);
  box-shadow:
    0 0 0 3rpx rgba(201, 118, 27, 0.85),
    0 12rpx 28rpx rgba(60, 45, 25, 0.12);
}

.pe-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.pe-avatar-btn {
  position: absolute;
  inset: 0;
  width: 100% !important;
  height: 100% !important;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
}

.pe-avatar-btn::after {
  display: none;
}

.pe-avatar-tip {
  font-size: 23rpx;
  color: var(--text-soft);
}

.pe-card {
  background: var(--ink-1);
  border: 1rpx solid var(--line-weak);
  border-radius: var(--r-card);
  padding: 8rpx var(--s4);
}

.pe-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s3);
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-weak);
}

.pe-field:last-child {
  border-bottom: none;
}

.pe-field--col {
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
}

.pe-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pe-label {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-mid);
}

.pe-counter {
  font-size: 21rpx;
  color: var(--text-low);
  font-variant-numeric: tabular-nums;
}

.pe-input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-hi);
  caret-color: var(--brand-neon);
}

.pe-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--r-inset);
  background: var(--ink-2);
  border: 1rpx solid var(--line-weak);
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-hi);
  caret-color: var(--brand-neon);
  box-sizing: border-box;
}

.pe-placeholder {
  color: var(--text-low);
}

.pe-readonly {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.pe-readonly-text {
  font-size: 26rpx;
  color: var(--text-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pe-group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hi);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pe-group-warn {
  margin-top: -12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: var(--brand-neon-active, #a85f11);
}

.pe-actions {
  margin-top: var(--s2);
  display: flex;
  flex-direction: column;
  gap: var(--s2);
}

.pe-logout {
  color: var(--danger);
  border-color: rgba(192, 57, 43, 0.25);
}
